[{"n":1,"en":"Alif, Lām, Meem.","bn":"আলিফ-লাম-মীম।","w":[["الٓمٓ","alif-lam-meem","Alif Lam Meem","আলিফ লাম - মীম-",1141]]},{"n":2,"en":"These are verses of the wise Book,","bn":"এগুলো হিকমাতে ভরপুর কিতাবের আয়াত।","w":[["تِلْكَ","til'ka","These","এই",12],["ءَايَـٰتُ","āyātu","(are) Verses","আয়াতগুলো",28],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের",48],["ٱلْحَكِيمِ","l-ḥakīmi","the Wise","(যা) জ্ঞানময়",112]]},{"n":3,"en":"As guidance and mercy for the doers of good","bn":"সৎকর্মশীলদের জন্য পথ নির্দেশ ও রহমত।","w":[["هُدًۭى","hudan","A guidance","পথ নির্দেশনা",126],["وَرَحْمَةًۭ","waraḥmatan","and a mercy","ও দয়াস্বরূপ",101],["لِّلْمُحْسِنِينَ","lil'muḥ'sinīna","for the good-doers","জন্যে সৎকর্মশীলদের",306]]},{"n":4,"en":"Who establish prayer and give zakāh, and they, of the Hereafter, are certain [in faith].","bn":"যারা নামায প্রতিষ্ঠা করে, যাকাত দেয় আর তারা আখেরাতের প্রতি দৃঢ় বিশ্বাস রাখে।","w":[["ٱلَّذِينَ","alladhīna","Those who","যারা",8],["يُقِيمُونَ","yuqīmūna","establish","তারা প্রতিষ্ঠা করে",214],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত",131],["وَيُؤْتُونَ","wayu'tūna","and give","ও তারা দেয়",44],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত",350],["وَهُم","wahum","and they","এবং তারা",21],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের",74],["هُمْ","hum","[they]","তারাই",81],["يُوقِنُونَ","yūqinūna","believe firmly","দৃঢ় বিশ্বাস করে",751]]},{"n":5,"en":"Those are on [right] guidance from their Lord, and it is those who are the successful.","bn":"তারাই তাদের পালনকর্তার সঠিক পথে আছে আর তারাই সফলকাম। (দুনিয়া ও আখেরাতে)","w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোকই)",12],["عَلَىٰ","ʿalā","(are) on","উপর (প্রতিষ্ঠিত)",9],["هُدًۭى","hudan","guidance","পথনির্দেশের",126],["مِّن","min","from","পক্ষ থেকে",1],["رَّبِّهِمْ ۖ","rabbihim","their Lord","রবের তাদের",13],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those","এবং ঐসব (লোক)",12],["هُمُ","humu","[they]","তারাই",137],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful","সফলকাম",695]]},{"n":6,"en":"And of the people is he who buys the amusement of speech to mislead [others] from the way of Allāh without knowledge and who takes it [i.e., His way] in ridicule. Those will have a humiliating punishment.","bn":"কতক মানুষ আল্লাহর পথ থেকে বিচ্যুত করার উদ্দেশ্যে অজ্ঞতাবশতঃ অবান্তর কথাবার্তা (গান-বাজনা) ক্রয় করে আর আল্লাহর পথকে ঠাট্টা-বিদ্রূপ করে। ওদের জন্যই আছে অবমাননাকর শাস্তি।","w":[["وَمِنَ","wamina","And of","এবং মধ্য থেকে",1],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের (এমনও আছে)",51],["مَن","man","(is he) who","যে",14],["يَشْتَرِى","yashtarī","purchases","কোনো",481],["لَهْوَ","lahwa","idle tales","অসার",849],["ٱلْحَدِيثِ","l-ḥadīthi","idle tales","কথা",387],["لِيُضِلَّ","liyuḍilla","to mislead","যেন সে বিভ্রান্ত করতে পারে",182],["عَن","ʿan","from","থেকে",23],["سَبِيلِ","sabīli","(the) path","পথ",63],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর",2],["بِغَيْرِ","bighayri","without","ছাড়া",77],["عِلْمٍۢ","ʿil'min","knowledge","কোনো জ্ঞান",107],["وَيَتَّخِذَهَا","wayattakhidhahā","and takes it","এবং গ্রহণ করে তা",95],["هُزُوًا ۚ","huzuwan","(in) ridicule","বিদ্রুপরূপে",800],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোক)",12],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)",11],["عَذَابٌۭ","ʿadhābun","(is) a punishment","শাস্তি",36],["مُّهِينٌۭ","muhīnun","humiliating","অপমানকর",666]]},{"n":7,"en":"And when Our verses are recited to him, he turns away arrogantly as if he had not heard them, as if there was in his ears deafness. So give him tidings of a painful punishment.","bn":"যখন তার কাছে আমার আয়াত আবৃত্তি করা হয়, তখন সে অহংকারবশতঃ এমনভাবে মুখ ফিরিয়ে নেয় যেন সে তা শুনতেই পায়নি, যেন তার দুই কানে বধিরতা আছে, কজেই তাকে ভয়াবহ শাস্তির সুসংবাদ দাও।","w":[["وَإِذَا","wa-idhā","And when","এবং যখন",25],["تُتْلَىٰ","tut'lā","are recited","তিলাওয়াত করা হয়",191],["عَلَيْهِ","ʿalayhi","to him","নিকট তার",9],["ءَايَـٰتُنَا","āyātunā","Our Verses","আয়াতসমূহ আমাদের",28],["وَلَّىٰ","wallā","he turns away","সে মুখ ফিরায়",372],["مُسْتَكْبِرًۭا","mus'takbiran","arrogantly","অহঙ্কারী হিসেবে",1227],["كَأَن","ka-an","as if","যেন",922],["لَّمْ","lam","not","নি",32],["يَسْمَعْهَا","yasmaʿhā","he (had) heard them","শুনতে পায় তা",141],["كَأَنَّ","ka-anna","as if","যেন",379],["فِىٓ","fī","in","মধ্যে (আছে)",4],["أُذُنَيْهِ","udhunayhi","his ears","দু'কানের তার",531],["وَقْرًۭا ۖ","waqran","(is) deafness","বধিরতা",1249],["فَبَشِّرْهُ","fabashir'hu","So give him tidings","অতএব সুসংবাদ দাও তাকে",303],["بِعَذَابٍ","biʿadhābin","of a punishment","ব্যাপারে শাস্তির",36],["أَلِيمٍ","alīmin","painful","নিদারুণ",159]]},{"n":8,"en":"Indeed, those who believe and do righteous deeds - for them are the Gardens of Pleasure,","bn":"যারা ঈমান আনে আর সৎকাজ করে তাদের জন্য আছে নি‘য়ামাতে ভরা জান্নাত।","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلَّذِينَ","alladhīna","those who","যারা",8],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে",19],["وَعَمِلُوا۟","waʿamilū","and do","ও কাজ করেছে",43],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ",188],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)",11],["جَنَّـٰتُ","jannātu","(are) Gardens","জান্নাতসমুহ",76],["ٱلنَّعِيمِ","l-naʿīmi","(of) Delight","সুখকর",576]]},{"n":9,"en":"Wherein they abide eternally; [it is] the promise of Allāh [which is] truth. And He is the Exalted in Might, the Wise.","bn":"তাতে তারা চিরকাল থাকবে। আল্লাহর ও‘য়াদা সত্য আর তিনি মহাপরাক্রমশালী, মহাপ্রজ্ঞাময়।","w":[["خَـٰلِدِينَ","khālidīna","(To) abide forever","চিরস্থায়ীভাবে থাকবে তারা",153],["فِيهَا ۖ","fīhā","in it","মধ্যে তার",4],["وَعْدَ","waʿda","(The) Promise of Allah","প্রতিশ্রুতি",241],["ٱللَّهِ","l-lahi","(The) Promise of Allah","আল্লাহ",2],["حَقًّۭا ۚ","ḥaqqan","(is) true","সত্য",49],["وَهُوَ","wahuwa","And He","এবং তিনিই",21],["ٱلْعَزِيزُ","l-ʿazīzu","(is) the All-Mighty","পরাক্রমশালী",110],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়",112]]},{"n":10,"en":"He created the heavens without pillars that you see and has cast into the earth firmly set mountains, lest it should shift with you, and dispersed therein from every creature. And We sent down rain from the sky and made grow therein [plants] of every noble kind.","bn":"তিনি আকাশমন্ডলী নির্মাণ করেছেন স্তম্ভ ছাড়া যা তোমরা দেখছ। তিনি পৃথিবীতে স্থাপন করেছেন দৃঢ়ভাবে দন্ডায়মান পর্বতমালা যাতে পৃথিবী তোমাদেরকে নিয়ে নড়াচড়া না করে আর তাতে ছড়িয়ে দিয়েছেন সকল প্রকার জীবজন্তু, আর আমিই আকাশ থেকে পানি বর্ষণ করি, অতঃপর তাতে উদ্গত করি যাবতীয় কল্যাণকর উদ্ভিদ।","w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন",60],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ",37],["بِغَيْرِ","bighayri","without","ছাড়া",77],["عَمَدٍۢ","ʿamadin","pillars","কোন খুঁটি",1911],["تَرَوْنَهَا ۖ","tarawnahā","that you see","তোমরা দেখছো তা",45],["وَأَلْقَىٰ","wa-alqā","and has cast","এবং স্থাপন করেছেন",163],["فِى","fī","in","মধ্যে",4],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর",24],["رَوَٰسِىَ","rawāsiya","firm mountains","পর্বতমালা",825],["أَن","an","lest","( এমন না হয় ) যে",18],["تَمِيدَ","tamīda","it (might) shake","ঢলে যায়",1784],["بِكُمْ","bikum","with you","নিয়ে তোমাদেরকে",20],["وَبَثَّ","wabatha","and He dispersed","এবং ছড়িয়ে দিয়েছেন",1287],["فِيهَا","fīhā","in it","মধ্যে তার",4],["مِن","min","from","প্রকার",1],["كُلِّ","kulli","every","প্রত্যেক",31],["دَآبَّةٍۢ ۚ","dābbatin","creature","জীবজন্তু",538],["وَأَنزَلْنَا","wa-anzalnā","And We sent down","এবং আমরা বর্ষণ করেছি",61],["مِنَ","mina","from","থেকে",1],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ",37],["مَآءًۭ","māan","water","পানি",187],["فَأَنۢبَتْنَا","fa-anbatnā","then We caused to grow","অতঃপর উৎপন্ন করি আমরা",584],["فِيهَا","fīhā","therein","মধ্যে তার",4],["مِن","min","of","প্রকার",1],["كُلِّ","kulli","every","প্রত্যেক",31],["زَوْجٍۢ","zawjin","kind","জোড়া জোড়া (উদ্ভিদ)",147],["كَرِيمٍ","karīmin","noble","উত্তম",368]]},{"n":11,"en":"This is the creation of Allāh. So show Me what those other than Him have created. Rather, the wrongdoers are in clear error.","bn":"এগুলো আল্লাহর সৃষ্টি। কাজেই আমাকে দেখাও তিনি ছাড়া অন্যেরা কী সৃষ্টি করেছে। বরং যালিমরা সুস্পষ্ট গুমরাহীতে ডুবে আছে।","w":[["هَـٰذَا","hādhā","This","এটা",12],["خَلْقُ","khalqu","(is the) creation","সৃষ্টি",222],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর",2],["فَأَرُونِى","fa-arūnī","So show Me","তাহ'লে দেখাও তোমরা আমাকে",283],["مَاذَا","mādhā","what","কি",418],["خَلَقَ","khalaqa","have created","সৃষ্টি করেছে",60],["ٱلَّذِينَ","alladhīna","those","(তারা) যারা (আছে)",8],["مِن","min","besides Him","ছাড়া",1],["دُونِهِۦ ۚ","dūnihi","besides Him","তিনি",79],["بَلِ","bali","Nay","বরং",94],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা",90],["فِى","fī","(are) in","মধ্যে(লিপ্ত)",4],["ضَلَـٰلٍۢ","ḍalālin","error","বিভ্রান্তির",305],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট",98]]},{"n":12,"en":"And We had certainly given Luqmān wisdom [and said], \"Be grateful to Allāh.\" And whoever is grateful is grateful for [the benefit of] himself. And whoever denies [His favor] - then indeed, Allāh is Free of need and Praiseworthy.","bn":"আমি লুকমানকে প্রজ্ঞা দান করেছিলাম। (তাকে বলেছিলাম) যে, তুমি আল্লাহর কৃতজ্ঞতা প্রকাশ কর। যে কৃতজ্ঞতা প্রকাশ করে, সে তা নিজের কল্যাণেই করে। আর কেউ অকৃতজ্ঞ হলে (সে জেনে রাখুক যে) আল্লাহ অমুখাপেক্ষী, প্রশংসিত।","w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই",26],["ءَاتَيْنَا","ātaynā","We gave","দিয়েছিলাম আমরা",44],["لُقْمَـٰنَ","luq'māna","Luqman","লুকমানকে",2601],["ٱلْحِكْمَةَ","l-ḥik'mata","the wisdom","প্রজ্ঞা",504],["أَنِ","ani","that","যে",18],["ٱشْكُرْ","ush'kur","Be grateful","তুমি কৃতজ্ঞতা প্রকাশ করো",249],["لِلَّهِ ۚ","lillahi","to Allah","জন্যে আল্লাহ্‌রই",2],["وَمَن","waman","And whoever","এবং যে",14],["يَشْكُرْ","yashkur","(is) grateful","(আল্লাহর) কৃতজ্ঞতা প্রকাশ করে",249],["فَإِنَّمَا","fa-innamā","then only","তখন মূলতঃ",6],["يَشْكُرُ","yashkuru","he is grateful","সে কৃতজ্ঞতা প্রকাশ করে",249],["لِنَفْسِهِۦ ۖ","linafsihi","for himself","জন্যে নিজের তার",38],["وَمَن","waman","And whoever","এবং যে",14],["كَفَرَ","kafara","(is) ungrateful","অকৃতজ্ঞ হয়",39],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই",6],["ٱللَّهَ","l-laha","Allah","আল্লাহ",2],["غَنِىٌّ","ghaniyyun","(is) Free of need","অমুখাপেক্ষী",440],["حَمِيدٌۭ","ḥamīdun","Praiseworthy","প্রশংসিত",567]]},{"n":13,"en":"And [mention, O Muḥammad], when Luqmān said to his son while he was instructing him, \"O my son, do not associate [anything] with Allāh. Indeed, association [with Him] is great injustice.\"","bn":"স্মরণ কর, যখন লুকমান তার ছেলেকে নসীহত ক’রে বলেছিল- হে বৎস! আল্লাহর সাথে কোন কিছুকে শিরক কর না, শিরক হচ্ছে অবশ্যই বিরাট যুলম।","w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন",52],["قَالَ","qāla","said","বলেছিলো",7],["لُقْمَـٰنُ","luq'mānu","Luqman","লুকমান",2601],["لِٱبْنِهِۦ","li-ib'nihi","to his son","উদ্দেশ্যে পুত্রের তার",184],["وَهُوَ","wahuwa","while he","এমতাবস্হায় যে সে",21],["يَعِظُهُۥ","yaʿiẓuhu","(was) instructing him","উপদেশ দিচ্ছিলো তাকে",635],["يَـٰبُنَىَّ","yābunayya","O my son","হে আমার পুত্র",136],["لَا","lā","(Do) not","না",5],["تُشْرِكْ","tush'rik","associate partners","শিরক করো",162],["بِٱللَّهِ ۖ","bil-lahi","with Allah","সাথে আল্লাহর(কাউকে)",2],["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلشِّرْكَ","l-shir'ka","associating partners","শিরক করা",1353],["لَظُلْمٌ","laẓul'mun","(is) surely an injustice","অবশ্যই সীমালঙ্ঘন",509],["عَظِيمٌۭ","ʿaẓīmun","great","চরম",103]]},{"n":14,"en":"And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination.","bn":"আমি মানুষকে তার পিতা-মাতার প্রতি সদ্ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে কষ্টের পর কষ্ট সহ্য করে গর্ভে ধারণ করে। তার দুধ ছাড়ানো হয় দু’বছরে, (নির্দেশ দিচ্ছি) যে, আমার প্রতি ও তোমার পিতামাতার প্রতি কৃতজ্ঞ হও। (তোমাদের সকলের) প্রত্যাবর্তন তো আমারই কাছে।","w":[["وَوَصَّيْنَا","wawaṣṣaynā","And We have enjoined","এবং জোর উপদেশ দিয়েছি আমরা",802],["ٱلْإِنسَـٰنَ","l-insāna","(upon) man","মানুষকে",164],["بِوَٰلِدَيْهِ","biwālidayhi","for his parents","সাথে তার মাতা-পিতার (ভালো ব্যবহারের জন্যে)",865],["حَمَلَتْهُ","ḥamalathu","carried him","বহন করেছে তাকে (পেটে)",278],["أُمُّهُۥ","ummuhu","his mother","মা তার",337],["وَهْنًا","wahnan","(in) weakness","কষ্টের",2761],["عَلَىٰ","ʿalā","upon","উপর",9],["وَهْنٍۢ","wahnin","weakness","কষ্ট (করে)",2761],["وَفِصَـٰلُهُۥ","wafiṣāluhu","and his weaning","এবং দুধ ছাড়ান তার",1940],["فِى","fī","(is) in","মধ্যে",4],["عَامَيْنِ","ʿāmayni","two years","দু'বছরের",909],["أَنِ","ani","that","যে",18],["ٱشْكُرْ","ush'kur","Be grateful","কৃতজ্ঞতা প্রকাশ করো",249],["لِى","lī","to Me","প্রতি আমার",11],["وَلِوَٰلِدَيْكَ","waliwālidayka","and to your parents","এবং প্রতি তোমার মা-বাপেরও",865],["إِلَىَّ","ilayya","towards Me","দিকে আমারই",15],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","(তোমাদের) প্রত্যাবর্তন",393]]},{"n":15,"en":"But if they endeavor to make you associate with Me that of which you have no knowledge, do not obey them but accompany them in [this] world with appropriate kindness and follow the way of those who turn back to Me [in repentance]. Then to Me will be your return, and I will inform you about what you used to do.","bn":"তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন। তখন আমি তোমাদেরকে জানিয়ে দেব তোমরা যা করছিলে।","w":[["وَإِن","wa-in","But if","এবং যদি",16],["جَـٰهَدَاكَ","jāhadāka","they strive against you","তারা দু'জনে তোমাকে চাপ দেয়",397],["عَلَىٰٓ","ʿalā","on","(এর)উপর",9],["أَن","an","that","যে",18],["تُشْرِكَ","tush'rika","you associate partners","তুমি শিরক করো",162],["بِى","bī","with Me","সাথে আমার",20],["مَا","mā","what","যা",3],["لَيْسَ","laysa","not","নেই",118],["لَكَ","laka","you have","কাছে তোমার",11],["بِهِۦ","bihi","of it","সম্পর্কে সে",20],["عِلْمٌۭ","ʿil'mun","any knowledge","কোনো জ্ঞান",107],["فَلَا","falā","then (do) not","তবে না",5],["تُطِعْهُمَا ۖ","tuṭiʿ'humā","obey both of them","উভয়ের (কাউকে) মানবে",158],["وَصَاحِبْهُمَا","waṣāḥib'