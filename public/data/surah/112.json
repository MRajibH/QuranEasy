[{"n":1,"en":"Say, \"He is Allāh, [who is] One,","bn":"বল, তিনি আল্লাহ, এক অদ্বিতীয়,","w":[["قُلْ","qul","Say","বলো",7],["هُوَ","huwa","He","তিনি",53],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ",2],["أَحَدٌ","aḥadun","the One","এক-অদ্বিতীয়",152]]},{"n":2,"en":"Allāh, the Eternal Refuge.","bn":"আল্লাহ কোন কিছুর মুখাপেক্ষী নন, সবই তাঁর মুখাপেক্ষী,","w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ",2],["ٱلصَّمَدُ","l-ṣamadu","the Eternal, the Absolute","অমুখাপেক্ষী",3785]]},{"n":3,"en":"He neither begets nor is born,","bn":"তিনি কাউকে জন্ম দেন না, আর তাঁকেও জন্ম দেয়া হয়নি।","w":[["لَمْ","lam","Not","নি",32],["يَلِدْ","yalid","He begets","তিনি (কাউকে) জন্ম দেন",935],["وَلَمْ","walam","and not","এবং নি",32],["يُولَدْ","yūlad","He is begotten","তাঁকে জন্ম দেয়া হয়",935]]},{"n":4,"en":"Nor is there to Him any equivalent.\"","bn":"তাঁর সমকক্ষ কেউ নয়।","w":[["وَلَمْ","walam","And not","এবং নাই",32],["يَكُن","yakun","is","(হয়)",10],["لَّهُۥ","lahu","for Him","তাঁর",11],["كُفُوًا","kufuwan","equivalent","সমতুল্য/ সমান",4074],["أَحَدٌۢ","aḥadun","any [one]","কেউই",152]]}]