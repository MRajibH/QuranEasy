[{"n":1,"en":"Have you seen the one who denies the Recompense?","bn":"তুমি কি তাকে দেখেছ, যে কর্মফল (দিবসকে) অস্বীকার করে?","w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি কি দেখেছ",45],["ٱلَّذِى","alladhī","the one who","(তাকে) যে",8],["يُكَذِّبُ","yukadhibu","denies","মিথ্যা অভিহিত করে",64],["بِٱلدِّينِ","bil-dīni","the Judgment","বিচার দিনকে",115]]},{"n":2,"en":"For that is the one who drives away the orphan","bn":"সে তো সেই (লোক) যে ইয়াতীমকে ধাক্কা দিয়ে সরিয়ে দেয়,","w":[["فَذَٰلِكَ","fadhālika","Then that","সে তো সে-ই",12],["ٱلَّذِى","alladhī","(is) the one who","যে",8],["يَدُعُّ","yaduʿʿu","repulses","ধাক্কা দেয়",2792],["ٱلْيَتِيمَ","l-yatīma","the orphan","ইয়াতিমকে",458]]},{"n":3,"en":"And does not encourage the feeding of the poor.","bn":"এবং মিসকীনকে অন্ন দিতে উৎসাহ দেয় না","w":[["وَلَا","walā","And (does) not","এবং না",5],["يَحُضُّ","yaḥuḍḍu","feel the urge","উৎসাহিত করে",2781],["عَلَىٰ","ʿalā","to","ব্যাপারে",9],["طَعَامِ","ṭaʿāmi","feed","খাদ্যদানের",439],["ٱلْمِسْكِينِ","l-mis'kīni","the poor","অভাবগ্রস্তকে",457]]},{"n":4,"en":"So woe to those who pray","bn":"অতএব দুর্ভোগ সে সব নামায আদায়কারীর","w":[["فَوَيْلٌۭ","fawaylun","So woe","অতএব দুর্ভোগ",294],["لِّلْمُصَلِّينَ","lil'muṣallīna","to those who pray","(ঐসব) সালাত আদায়কারীদের জন্য",2002]]},{"n":5,"en":"[But] who are heedless of their prayer -","bn":"যারা নিজেদের নামাযের ব্যাপারে উদাসীন,","w":[["ٱلَّذِينَ","alladhīna","Those who","যাদের (বৈশিষ্ট্য হলো)",8],["هُمْ","hum","[they]","তারা",81],["عَن","ʿan","about","সম্বন্ধে",23],["صَلَاتِهِمْ","ṣalātihim","their prayers","তাদের সালাত",131],["سَاهُونَ","sāhūna","(are) neglectful","উদাসীন",2414]]},{"n":6,"en":"Those who make show [of their deeds]","bn":"যারা লোক দেখানোর জন্য তা করে,","w":[["ٱلَّذِينَ","alladhīna","Those who","যাদের (বৈশিষ্ট্য হলো)",8],["هُمْ","hum","[they]","তারা",81],["يُرَآءُونَ","yurāūna","make show","লোকদেখানোর (কাজ করে)",2794]]},{"n":7,"en":"And withhold [simple] assistance.","bn":"এবং প্রয়োজনীয় গৃহসামগ্রী দানের ছোট খাট সাহায্য করা থেকেও বিরত থাকে।","w":[["وَيَمْنَعُونَ","wayamnaʿūna","And they deny","এবং দেওয়া হতে বিরত থাকে",744],["ٱلْمَاعُونَ","l-māʿūna","[the] small kindnesses","সংসারের প্রয়োজনীয় ছোটখাটো জিনিসের",4128]]}]