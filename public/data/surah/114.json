[{"n":1,"en":"Say, \"I seek refuge in the Lord of mankind,","bn":"বল, ‘আমি আশ্রয় চাচ্ছি মানুষের প্রতিপালকের,","w":[["قُلْ","qul","Say","বলো",7],["أَعُوذُ","aʿūdhu","I seek refuge","আমি আশ্রয় চাই",840],["بِرَبِّ","birabbi","in (the) Lord","রবের নিকট",13],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের",51]]},{"n":2,"en":"The Sovereign of mankind,","bn":"মানুষের অধিপতির,","w":[["مَلِكِ","maliki","(The) King","মহা অধিপতির (নিকট)",631],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের",51]]},{"n":3,"en":"The God of mankind,","bn":"মানুষের প্রকৃত ইলাহর,","w":[["إِلَـٰهِ","ilāhi","(The) God","ইলাহ্‌র (নিকট)",75],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের",51]]},{"n":4,"en":"From the evil of the retreating whisperer -","bn":"যে নিজেকে লুকিয়ে রেখে বার বার এসে কুমন্ত্রণা দেয় তার অনিষ্ট হতে,","w":[["مِن","min","From","হতে",1],["شَرِّ","sharri","(the) evil","অমঙ্গল",363],["ٱلْوَسْوَاسِ","l-waswāsi","(of) the whisperer","কুমন্ত্রণার",4644],["ٱلْخَنَّاسِ","l-khanāsi","the one who withdraws","আত্নগোপনকারী",3471]]},{"n":5,"en":"Who whispers [evil] into the breasts of mankind -","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","w":[["ٱلَّذِى","alladhī","The one who","যে",8],["يُوَسْوِسُ","yuwaswisu","whispers","কুমন্ত্রণা দেয়",1671],["فِى","fī","in","মধ্যে",4],["صُدُورِ","ṣudūri","(the) breasts","অন্তরসমূহের",262],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের",51]]},{"n":6,"en":"From among the jinn and mankind\".","bn":"(এই কুমন্ত্রণাদাতা হচ্ছে) জিন্নের মধ্য হতে এবং মানুষের মধ্য হতে।","w":[["مِنَ","mina","From","মধ্য হতে",1],["ٱلْجِنَّةِ","l-jinati","the jinn","জিনের",817],["وَٱلنَّاسِ","wal-nāsi","and men","ও মানুষের",51]]}]