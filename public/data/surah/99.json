[{"n":1,"en":"When the earth is shaken with its [final] earthquake","bn":"পৃথিবীকে যখন তার প্রচন্ড কম্পনে কাঁপিয়ে দেয়া হবে,","w":[["إِذَا","idhā","When","যখন",25],["زُلْزِلَتِ","zul'zilati","is shaken","প্রকম্পিত হবে",1863],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী",24],["زِلْزَالَهَا","zil'zālahā","(with) its earthquake","তার (ভীষণ) কম্পনে",2407]]},{"n":2,"en":"And the earth discharges its burdens","bn":"পৃথিবী তার (ভেতরের যাবতীয়) বোঝা বাইরে নিক্ষেপ করবে,","w":[["وَأَخْرَجَتِ","wa-akhrajati","And brings forth","এবং বের করবে",111],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী",24],["أَثْقَالَهَا","athqālahā","its burdens","বোঝাগুলোকে তার",1154]]},{"n":3,"en":"And man says, \"What is [wrong] with it?\" -","bn":"এবং মানুষ বলবে ‘এর কী হয়েছে?’","w":[["وَقَالَ","waqāla","And says","এবং বলবে",7],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ",164],["مَا","mā","What","কি",3],["لَهَا","lahā","(is) with it","হয়েছে তার",11]]},{"n":4,"en":"That Day, it will report its news","bn":"সে দিন পৃথিবী তার (নিজের উপর সংঘটিত) বৃত্তান্ত বর্ণনা করবে,","w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন",22],["تُحَدِّثُ","tuḥaddithu","it will report","সে বর্ণনা করবে",1774],["أَخْبَارَهَا","akhbārahā","its news","তার বৃত্তান্ত",1708]]},{"n":5,"en":"Because your Lord has inspired [i.e., commanded] it.","bn":"কারণ তোমার প্রতিপালক তাকে আদেশ করবেন,","w":[["بِأَنَّ","bi-anna","Because","কেননা",30],["رَبَّكَ","rabbaka","your Lord","তোমার রব",13],["أَوْحَىٰ","awḥā","inspired","আদেশ করবেন (এইরূপ করার)",160],["لَهَا","lahā","[to] it","তাকে",11]]},{"n":6,"en":"That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.","bn":"সেদিন মানুষ বের হবে ভিন্ন ভিন্ন দলে যাতে তাদেরকে তাদের কৃতকর্ম দেখানো যায়,","w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন",22],["يَصْدُرُ","yaṣduru","will proceed","বের হবে",4750],["ٱلنَّاسُ","l-nāsu","the mankind","মানুষ",51],["أَشْتَاتًۭا","ashtātan","(in) scattered groups","দলে দলে ভাগ হয়ে",2132],["لِّيُرَوْا۟","liyuraw","to be shown","দেখানোর জন্য",283],["أَعْمَـٰلَهُمْ","aʿmālahum","their deeds","তাদের কৃতকর্মকে",166]]},{"n":7,"en":"So whoever does an atom's weight of good will see it,","bn":"অতএব কেউ অণু পরিমাণও সৎ কাজ করলে সে তা দেখবে,","w":[["فَمَن","faman","So whoever","অতঃপর যে",14],["يَعْمَلْ","yaʿmal","does","করবে",43],["مِثْقَالَ","mith'qāla","(equal to the) weight","পরিমাণ",1002],["ذَرَّةٍ","dharratin","(of) an atom","অণু",1168],["خَيْرًۭا","khayran","good","সৎকর্ম",62],["يَرَهُۥ","yarahu","will see it","সে তা দেখবে",45]]},{"n":8,"en":"And whoever does an atom's weight of evil will see it.","bn":"আর কেউ অণু পরিমাণও অসৎ কাজ করলে সেও তা দেখবে।","w":[["وَمَن","waman","And whoever","এবং যে",14],["يَعْمَلْ","yaʿmal","does","করবে",43],["مِثْقَالَ","mith'qāla","(equal to the) weight","পরিমাণ",1002],["ذَرَّةٍۢ","dharratin","(of) an atom","অণু",1168],["شَرًّۭا","sharran","evil","অসৎকর্ম",363],["يَرَهُۥ","yarahu","will see it","সে তা দেখবে",45]]}]