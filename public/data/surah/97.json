[{"n":1,"en":"Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.","bn":"আমি কুরআনকে কাদরের রাতে নাযিল করেছি,","w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই",6],["أَنزَلْنَـٰهُ","anzalnāhu","revealed it","তা আমরা অবতীর্ণ করেছি",61],["فِى","fī","in","মধ্যে",4],["لَيْلَةِ","laylati","(the) Night","রাতের",999],["ٱلْقَدْرِ","l-qadri","(of) Power","কদরের/ মহিমার",1098]]},{"n":2,"en":"And what can make you know what is the Night of Decree?","bn":"তুমি কি জান ক্বাদরের রাত কী?","w":[["وَمَآ","wamā","And what","এবং কিসে",3],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে",554],["مَا","mā","what","কি সেই",3],["لَيْلَةُ","laylatu","(the) Night","রাত",999],["ٱلْقَدْرِ","l-qadri","(of) Power (is)","কদরের",1098]]},{"n":3,"en":"The Night of Decree is better than a thousand months.","bn":"ক্বাদরের রাত হাজার মাসের চেয়েও অধিক উত্তম,","w":[["لَيْلَةُ","laylatu","(The) Night","রাত",999],["ٱلْقَدْرِ","l-qadri","(of) Power","কদরের",1098],["خَيْرٌۭ","khayrun","(is) better","শ্রেষ্ঠ",62],["مِّنْ","min","than","হতেও",1],["أَلْفِ","alfi","a thousand","হাজার",642],["شَهْرٍۢ","shahrin","month(s)","মাস",485]]},{"n":4,"en":"The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.","bn":"এ রাতে ফেরেশতা আর রূহ তাদের রব-এর অনুমতিক্রমে প্রত্যেক কাজে অবতীর্ণ হয়।","w":[["تَنَزَّلُ","tanazzalu","Descend","অবতীর্ণ হয়",1049],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা",122],["وَٱلرُّوحُ","wal-rūḥu","and the Spirit","এবং রূহ (জিব্রাঈল)",483],["فِيهَا","fīhā","therein","তার মধ্যে",4],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতিক্রমে",296],["رَبِّهِم","rabbihim","(of) their Lord","তাদের রবের",13],["مِّن","min","for","প্রত্যেক",1],["كُلِّ","kulli","every","সব",31],["أَمْرٍۢ","amrin","affair","কাজে",66]]},{"n":5,"en":"Peace it is until the emergence of dawn.","bn":"(এ রাতে বিরাজ করে) শান্তি আর শান্তি- ফজর উদয় হওয়া পর্যন্ত।","w":[["سَلَـٰمٌ","salāmun","Peace","শান্তির",274],["هِىَ","hiya","it (is)","সেই (রাত)",256],["حَتَّىٰ","ḥattā","until","পর্যন্ত",82],["مَطْلَعِ","maṭlaʿi","(the) emergence","উদয়",4319],["ٱلْفَجْرِ","l-fajri","(of) the dawn","ঊষার",1202]]}]