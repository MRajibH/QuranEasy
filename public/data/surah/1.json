[{"n":1,"en":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","bn":"(আরম্ভ করছি) পরম করুণাময় অসীম দয়াময় আল্লাহর নামে।","w":[["بِسْمِ","bis'mi","In (the) name","নামে",297],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ (র)",2],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","পরম করুণাময়",201],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","অসীম দয়ালু",99]]},{"n":2,"en":"[All] praise is [due] to Allāh, Lord of the worlds -","bn":"যাবতীয় প্রশংসা জগৎসমূহের প্রতিপালক আল্লাহরই জন্য।","w":[["ٱلْحَمْدُ","al-ḥamdu","All praises and thanks","সকল প্রশংসা",267],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহ্‌রই জন্য",2],["رَبِّ","rabbi","the Lord","(যিনি) রব",13],["ٱلْعَـٰلَمِينَ","l-ʿālamīna","of the universe","সারা জগতের",157]]},{"n":3,"en":"The Entirely Merciful, the Especially Merciful,","bn":"যিনি পরম করুণাময় অতি দয়ালু।","w":[["ٱلرَّحْمَـٰنِ","al-raḥmāni","The Most Gracious","অশেষ করুণাময়",201],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","পরম দয়ালু",99]]},{"n":4,"en":"Sovereign of the Day of Recompense.","bn":"যিনি প্রতিফল দিবসের মালিক।","w":[["مَـٰلِكِ","māliki","(The) Master","অধিপতি",1621],["يَوْمِ","yawmi","(of the) Day","দিনের",22],["ٱلدِّينِ","l-dīni","(of the) Judgment","বিচারের",115]]},{"n":5,"en":"It is You we worship and You we ask for help.","bn":"আমরা কেবল তোমারই ‘ইবাদাত করি এবং কেবলমাত্র তোমারই সাহায্য প্রার্থনা করি।","w":[["إِيَّاكَ","iyyāka","You Alone","আপনারই শুধু",435],["نَعْبُدُ","naʿbudu","we worship","আমরা ইবাদত করি",96],["وَإِيَّاكَ","wa-iyyāka","and You Alone","এবং আপনারই (কাছে শুধু)",435],["نَسْتَعِينُ","nastaʿīnu","we ask for help","আমরা সাহায্য চাই",1483]]},{"n":6,"en":"Guide us to the straight path -","bn":"আমাদেরকে সরল সঠিক পথ প্রদর্শন কর ও তার প্রতি অটুট থাকার তাওফীক দান কর।","w":[["ٱهْدِنَا","ih'dinā","Guide us","আমাদেরকে দেখান",80],["ٱلصِّرَٰطَ","l-ṣirāṭa","(to) the path","পথ",254],["ٱلْمُسْتَقِيمَ","l-mus'taqīma","the straight","সরল সঠিক",317]]},{"n":7,"en":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","bn":"তাদের পথ, যাদের প্রতি তুমি অনুগ্রহ করেছ। তাদের পথ, যারা গযবপ্রাপ্ত (ইয়াহূদী) ও পথভ্রষ্ট (খ্রিস্টান) নয়।","w":[["صِرَٰطَ","ṣirāṭa","(The) path","(সেই) পথে",254],["ٱلَّذِينَ","alladhīna","(of) those","যাদেরকে",8],["أَنْعَمْتَ","anʿamta","You have bestowed (Your) Favors","আপনি অনুগ্রহ দান করেছেন",556],["عَلَيْهِمْ","ʿalayhim","on them","তাদের উপর",9],["غَيْرِ","ghayri","not (of)","নয় (পথ)",77],["ٱلْمَغْضُوبِ","l-maghḍūbi","those who earned (Your) wrath","অভিশপ্তদের",4357],["عَلَيْهِمْ","ʿalayhim","on themselves","যাদের উপর (গজব পরেছে)",9],["وَلَا","walā","and not","এবং না",5],["ٱلضَّآلِّينَ","l-ḍālīna","(of) those who go astray","পথভ্রষ্টদের",653]]}]