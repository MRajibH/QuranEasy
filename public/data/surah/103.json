[{"n":1,"en":"By time,","bn":"কালের শপথ","w":[["وَٱلْعَصْرِ","wal-ʿaṣri","By the time","শপথ মহাকালের",3886]]},{"n":2,"en":"Indeed, mankind is in loss,","bn":"মানুষ অবশ্যই ক্ষতির মধ্যে (ডুবে) আছে,","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلْإِنسَـٰنَ","l-insāna","mankind","মানুষ",164],["لَفِى","lafī","(is) surely, in","অবশ্যই মধ্যে",4],["خُسْرٍ","khus'rin","loss","ক্ষতির",2342]]},{"n":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","bn":"কিন্তু তারা নয় যারা ঈমান আনে ও সৎকর্ম করে এবং পরস্পরকে সত্যের উপদেশ দেয় এবং পরস্পরকে ধৈর্য ধারণের উপদেশ দেয়।","w":[["إِلَّا","illā","Except","(তাদের) ছাড়া",17],["ٱلَّذِينَ","alladhīna","those who","যারা",8],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে",19],["وَعَمِلُوا۟","waʿamilū","and do","এবং করেছে",43],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্মের",188],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","এবং পরস্পরকে উপদেশ দিয়েছে",1305],["بِٱلْحَقِّ","bil-ḥaqi","to the truth","সত্যের",49],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","ও পরস্পরকে উপদেশ দিয়েছে",1305],["بِٱلصَّبْرِ","bil-ṣabri","to [the] patience","ধৈর্যের",621]]}]