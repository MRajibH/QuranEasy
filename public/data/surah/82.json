[{"n":1,"en":"When the sky breaks apart","bn":"যখন আসমান ফেটে যাবে,","w":[["إِذَا","idhā","When","যখন",25],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ",37],["ٱنفَطَرَتْ","infaṭarat","(is) cleft asunder","ফেটে যাবে",3060]]},{"n":2,"en":"And when the stars fall, scattering,","bn":"যখন তারকাগুলো বিক্ষিপ্ত হয়ে (ঝরে) পড়বে,","w":[["وَإِذَا","wa-idhā","And when","এবং যখন",25],["ٱلْكَوَاكِبُ","l-kawākibu","the stars","তারাগুলো",1396],["ٱنتَثَرَتْ","intatharat","scatter","বিক্ষিপ্ত হবে",3055]]},{"n":3,"en":"And when the seas are erupted","bn":"সমুদ্রকে যখন উত্তাল করে তোলা হবে,","w":[["وَإِذَا","wa-idhā","And when","এবং যখন",25],["ٱلْبِحَارُ","l-biḥāru","the seas","সাগরগুলো",277],["فُجِّرَتْ","fujjirat","are made to gush forth","উথলে উঠবে",1203]]},{"n":4,"en":"And when the [contents of] graves are scattered [i.e., exposed],","bn":"যখন কবরস্থ মানুষদেরকে উঠানো হবে,","w":[["وَإِذَا","wa-idhā","And when","এবং যখন",25],["ٱلْقُبُورُ","l-qubūru","the graves","কবরগুলো",1209],["بُعْثِرَتْ","buʿ'thirat","are overturned","উন্মোচিত হবে",2231]]},{"n":5,"en":"A soul will [then] know what it has put forth and kept back.","bn":"তখন প্রত্যেকে জেনে নিবে সে কী আগে পাঠিয়েছিল, আর কী পেছনে ছেড়ে এসেছিল।","w":[["عَلِمَتْ","ʿalimat","Will know","জানবে",29],["نَفْسٌۭ","nafsun","a soul","প্রত্যেক ব্যক্তি",38],["مَّا","mā","what","যা",3],["قَدَّمَتْ","qaddamat","it has sent forth","সে আগে পাঠিয়েছে",401],["وَأَخَّرَتْ","wa-akharat","and left behind","এবং পিছনে ছেড়েছে",607]]},{"n":6,"en":"O mankind, what has deceived you concerning your Lord, the Generous,","bn":"হে মানুষ! কিসে তোমাকে তোমার মহান প্রতিপালক সম্পর্কে ধোঁকায় ফেলে দিয়েছে?","w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে",55],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ",164],["مَا","mā","What","কিসে",3],["غَرَّكَ","gharraka","has deceived you","তোমাকে ধোঁকা দিয়েছে",625],["بِرَبِّكَ","birabbika","concerning your Lord","তোমার রবের ব্যাপারে",13],["ٱلْكَرِيمِ","l-karīmi","the Most Noble","মহান",368]]},{"n":7,"en":"Who created you, proportioned you, and balanced you?","bn":"যিনি তোমাকে সৃষ্টি করেছেন, অতঃপর তোমাকে সুঠাম করেছেন, অতঃপর তোমাকে করেছেন ভারসাম্যপূর্ণ।","w":[["ٱلَّذِى","alladhī","Who","যিনি",8],["خَلَقَكَ","khalaqaka","created you","তোমাকে সৃষ্টি করেছেন",60],["فَسَوَّىٰكَ","fasawwāka","then fashioned you","অতঃপর তোমাকে সুঠাম করেছেন",683],["فَعَدَلَكَ","faʿadalaka","then balanced you","অতঃপর তোমাকে সুসামঞ্জস্য করেছেন",655]]},{"n":8,"en":"In whatever form He willed has He assembled you.","bn":"তিনি তোমাকে তাঁর ইচ্ছেমত আকৃতিতে গঠন করেছেন।","w":[["فِىٓ","fī","In","মধ্যে",4],["أَىِّ","ayyi","whatever","যে",55],["صُورَةٍۢ","ṣūratin","form","আকৃতিতে",1892],["مَّا","mā","what","(যা) যেমন",3],["شَآءَ","shāa","He willed","তিনি চেয়েছেন",54],["رَكَّبَكَ","rakkabaka","He assembled you","তোমাকে গঠন করেছেন",3563]]},{"n":9,"en":"No! But you deny the Recompense.","bn":"না (তোমাদের এই বিভ্রান্তি মোটেই সঠিক নয়), তোমরা তো (আখেরাতের) শাস্তি ও পুরস্কারকে অস্বীকার করে থাক;","w":[["كَلَّا","kallā","Nay","কখনও নয়",346],["بَلْ","bal","But","বরং",94],["تُكَذِّبُونَ","tukadhibūna","you deny","তোমারা মিথ্যা মনে করছ",64],["بِٱلدِّينِ","bil-dīni","the Judgment","শেষ বিচারকে",115]]},{"n":10,"en":"And indeed, [appointed] over you are keepers,","bn":"অবশ্যই তোমাদের উপর নিযুক্ত আছে তত্ত্বাবধায়কগণ;","w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই",6],["عَلَيْكُمْ","ʿalaykum","over you","তোমাদের উপর",9],["لَحَـٰفِظِينَ","laḥāfiẓīna","(are) surely guardians","সংরক্ষক দল অবশ্যই (আছে)",678]]},{"n":11,"en":"Noble and recording;","bn":"সম্মানিত লেখকগণ (যারা লিপিবদ্ধ করছে তোমাদের কার্যকলাপ),","w":[["كِرَامًۭا","kirāman","Noble","সম্মানিত",368],["كَـٰتِبِينَ","kātibīna","recording","লেখকবৃন্দ",1216]]},{"n":12,"en":"They know whatever you do.","bn":"তারা জানে তোমরা যা কর।","w":[["يَعْلَمُونَ","yaʿlamūna","They know","তারা জানে",29],["مَا","mā","whatever","যা",3],["تَفْعَلُونَ","tafʿalūna","you do","তোমরা কর",120]]},{"n":13,"en":"Indeed, the righteous will be in pleasure,","bn":"নেককারগণ থাকবে নানান নি‘মাতের মাঝে","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلْأَبْرَارَ","l-abrāra","the righteous","সৎ ব্যক্তিরা",461],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে(থাকবে)",4],["نَعِيمٍۢ","naʿīmin","bliss","স্বাচ্ছন্দ্যে (সুখে-শান্তিতে)",576]]},{"n":14,"en":"And indeed, the wicked will be in Hellfire.","bn":"আর পাপীরা থাকবে জাহান্নামে,","w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই",6],["ٱلْفُجَّارَ","l-fujāra","the wicked","পাপাচারীরা",1596],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে (যাবে)",4],["جَحِيمٍۢ","jaḥīmin","Hellfire","দোজখের",412]]},{"n":15,"en":"They will [enter to] burn therein on the Day of Recompense,","bn":"কর্মফলের দিন তারা তাতে প্রবেশ করবে।","w":[["يَصْلَوْنَهَا","yaṣlawnahā","They will burn (in) it","সেখানে তারা প্রবেশ করবে",700],["يَوْمَ","yawma","(on the) Day","দিনে",22],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচার",115]]},{"n":16,"en":"And never therefrom will they be absent.","bn":"তারা সেখান থেকে কক্ষনো উধাও হয়ে যেতে পারবে না।","w":[["وَمَا","wamā","And not","এবং না",3],["هُمْ","hum","they","তারা",81],["عَنْهَا","ʿanhā","from it","তা থেকে",23],["بِغَآئِبِينَ","bighāibīna","(will be) absent","অনুপস্থিত (থাকতে সক্ষম হবে)",1915]]},{"n":17,"en":"And what can make you know what is the Day of Recompense?","bn":"তুমি কি জান কর্মফলের দিনটি কী?","w":[["وَمَآ","wamā","And what","এবং কিসে",3],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে",554],["مَا","mā","what","কি (সেই)",3],["يَوْمُ","yawmu","(is the) Day","দিন",22],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের",115]]},{"n":18,"en":"Then, what can make you know what is the Day of Recompense?","bn":"আবার বলি, তুমি কি জান কর্মফলের দিনটি কী ?","w":[["ثُمَّ","thumma","Then","অতঃপর",34],["مَآ","mā","what","কিসে",3],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে",554],["مَا","mā","what","কি সেই",3],["يَوْمُ","yawmu","(is the) Day","দিন",22],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের",115]]},{"n":19,"en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","bn":"সেদিন কোন মানুষ অপরের জন্য কিছু করার সামর্থ্য রাখবে না, সেদিন সকল কর্তৃত্ব থাকবে একমাত্র আল্লাহরই (ইখতিয়ারে)।","w":[["يَوْمَ","yawma","(The) Day","সেদিন",22],["لَا","lā","not","না",5],["تَمْلِكُ","tamliku","will have power","সক্ষম হবে",264],["نَفْسٌۭ","nafsun","a soul","কেউ",38],["لِّنَفْسٍۢ","linafsin","for a soul","কারও জন্যে",38],["شَيْـًۭٔا ۖ","shayan","anything","কিছু (করতে)",40],["وَٱلْأَمْرُ","wal-amru","and the Command","এবং কর্তৃত্ব",66],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন (হবে কেবল)",22],["لِّلَّهِ","lillahi","(will be) with Allah","আল্লাহর জন্যে",2]]}]