[{"n":1,"en":"By the sky and the night comer","bn":"শপথ আসমানের আর যা রাতে আসে তার,","w":[["وَٱلسَّمَآءِ","wal-samāi","By the sky","শপথ আকাশের",37],["وَٱلطَّارِقِ","wal-ṭāriqi","and the night comer","এবং রাত্রে আত্মপ্রকাশকারী (নক্ষত্রের)",2478]]},{"n":2,"en":"And what can make you know what is the night comer?","bn":"তুমি কি জান যা রাতে আসে তা কী?","w":[["وَمَآ","wamā","And what","এবং কিসে",3],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে",554],["مَا","mā","what","কি সেই",3],["ٱلطَّارِقُ","l-ṭāriqu","the night comer (is)","রাতে আত্মপ্রকাশকারী",2478]]},{"n":3,"en":"It is the piercing star","bn":"উজ্জ্বল নক্ষত্র।","w":[["ٱلنَّجْمُ","al-najmu","(It is) the star","নক্ষত্র",697],["ٱلثَّاقِبُ","l-thāqibu","the piercing","উজ্জ্বল",2288]]},{"n":4,"en":"There is no soul but that it has over it a protector.","bn":"প্রত্যেক আত্মার সাথে একজন সংরক্ষক আছে।","w":[["إِن","in","Not","নেই",16],["كُلُّ","kullu","(is) every","কোন",31],["نَفْسٍۢ","nafsin","soul","ব্যক্তি",38],["لَّمَّا","lammā","but","এ ছাড়া যে",68],["عَلَيْهَا","ʿalayhā","over it","তার উপর",9],["حَافِظٌۭ","ḥāfiẓun","(is) a protector","তত্ত্বাবধায়ক",678]]},{"n":5,"en":"So let man observe from what he was created.","bn":"অতঃপর মানুষ চিন্তা করে দেখুক কোন জিনিস থেকে তাকে সৃষ্টি করা হয়েছে।","w":[["فَلْيَنظُرِ","falyanẓuri","So let see","অতএব লক্ষ করা উচিৎ",123],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষের",164],["مِمَّ","mimma","from what","কি থেকে",1],["خُلِقَ","khuliqa","he is created","সৃষ্টি করা হয়েছে (তাকে)",60]]},{"n":6,"en":"He was created from a fluid, ejected,","bn":"তাকে সৃষ্টি করা হয়েছে সবেগে বের হয়ে আসা পানি থেকে।","w":[["خُلِقَ","khuliqa","He is created","সৃষ্টি করা হয়েছে",60],["مِن","min","from","থেকে",1],["مَّآءٍۢ","māin","a water","পানি",187],["دَافِقٍۢ","dāfiqin","ejected","সবেগে স্খলিত",3478]]},{"n":7,"en":"Emerging from between the backbone and the ribs.","bn":"যা বের হয় শিরদাঁড়া ও পাঁজরের মাঝখান থেকে।","w":[["يَخْرُجُ","yakhruju","Coming forth","যা বের হয়",218],["مِنۢ","min","from","থেকে",1],["بَيْنِ","bayni","between","মাঝ",46],["ٱلصُّلْبِ","l-ṣul'bi","the backbone","মেরুদণ্ড",2466],["وَٱلتَّرَآئِبِ","wal-tarāibi","and the ribs","ও বক্ষপিঞ্জরের",3176]]},{"n":8,"en":"Indeed, He [i.e., Allāh], to return him [to life], is Able.","bn":"তিনি মানুষকে আবার (জীবনে) ফিরিয়ে আনতে অবশ্যই সক্ষম।","w":[["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি",6],["عَلَىٰ","ʿalā","to","ব্যাপারে",9],["رَجْعِهِۦ","rajʿihi","return him","তার প্রত্যাবর্তনে",1848],["لَقَادِرٌۭ","laqādirun","(is) Able","অবশ্যই সক্ষম",658]]},{"n":9,"en":"The Day when secrets will be put on trial,","bn":"যেদিন (কাজকর্ম আকীদা বিশ্বাস ও নিয়্যাত সম্পর্কিত) গোপন বিষয়াদি যাচাই পরখ করা হবে।","w":[["يَوْمَ","yawma","(The) Day","সেদিন",22],["تُبْلَى","tub'lā","will be tested","পরীক্ষা করা হবে",501],["ٱلسَّرَآئِرُ","l-sarāiru","the secrets","গোপন বিষয়াবলী",3656]]},{"n":10,"en":"Then he [i.e., man] will have no power or any helper.","bn":"সেদিন মানুষের না থাকবে নিজের কোন সামর্থ্য, আর না থাকবে কোন সাহায্যকারী।","w":[["فَمَا","famā","Then not","অতঃপর না",3],["لَهُۥ","lahu","(is) for him","তার জন্য (থাকবে)",11],["مِن","min","any","কোন",1],["قُوَّةٍۢ","quwwatin","power","শক্তি",367],["وَلَا","walā","and not","আর না",5],["نَاصِرٍۢ","nāṣirin","any helper","কোনো সাহায্যকারী",795]]},{"n":11,"en":"By the sky which sends back","bn":"ঘুরে ঘুরে আসা বৃষ্টিবাহী আকাশের শপথ,","w":[["وَٱلسَّمَآءِ","wal-samāi","By the sky","শপথ আকাশের",37],["ذَاتِ","dhāti","which","ধারণকারী",72],["ٱلرَّجْعِ","l-rajʿi","returns","বৃষ্টির",1848]]},{"n":12,"en":"And [by] the earth which splits,","bn":"এবং গাছপালার চারা গজানোর সময় বক্ষ দীর্ণকারী যমীনের শপথ, (বৃষ্টিপাতের মাধ্যমে বৃক্ষলতার উৎপাদন যেমন অকাট্য সত্য, তেমনি কুরআন যা ঘোষণা করে তাও অকাট্য সত্য)","w":[["وَٱلْأَرْضِ","wal-arḍi","And the earth","শপথ পৃথিবীর (যা)",24],["ذَاتِ","dhāti","which","বিশিষ্ট",72],["ٱلصَّدْعِ","l-ṣadʿi","cracks open","বিদীর্ণ (বক্ষ)",3759]]},{"n":13,"en":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","bn":"কুরআন (সত্য-মিথ্যার পার্থক্যকারী) চূড়ান্ত সিদ্ধান্তকারী বাণী,","w":[["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয় তা",6],["لَقَوْلٌۭ","laqawlun","(is) surely a Word","অবশ্যই বাণী",116],["فَصْلٌۭ","faṣlun","decisive","মীমাংসাকারী",919]]},{"n":14,"en":"And it is not amusement.","bn":"এবং তা কোন হাসি-ঠাট্টামূলক কথা নয়।","w":[["وَمَا","wamā","And not","এবং না",3],["هُوَ","huwa","it","তা",53],["بِٱلْهَزْلِ","bil-hazli","(is) for amusement","হাসি-ঠাট্টার কথা",4599]]},{"n":15,"en":"Indeed, they are planning a plan,","bn":"এবং তারা (সত্যের বিরুদ্ধে) ষড়যন্ত্র করছে,","w":[["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা",6],["يَكِيدُونَ","yakīdūna","are plotting","ষড়যন্ত্র করছে",997],["كَيْدًۭا","kaydan","a plot","ভীষণ ষড়যন্ত্র",417]]},{"n":16,"en":"But I am planning a plan.","bn":"আর আমিও (তাদের অন্যায় ধ্বংসাত্মক ষড়যন্ত্র ভন্ডুল করার) কৌশল করছি।","w":[["وَأَكِيدُ","wa-akīdu","But I am planning","এবং আমি কৌশল করছি",997],["كَيْدًۭا","kaydan","a plan","ভীষণ কৌশল",417]]},{"n":17,"en":"So allow time for the disbelievers. Leave them awhile.","bn":"কাজেই (এই ষড়যন্ত্রকারী) কাফিরদেরকে অবকাশ দাও, তাদেরকে কিছু সময়ের জন্য অবকাশ দাও।","w":[["فَمَهِّلِ","famahhili","So give respite","তাই অবকাশ দাও",2703],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(to) the disbelievers","কাফেরদেরকে",73],["أَمْهِلْهُمْ","amhil'hum","Give respite to them","তাদের অবকাশ দাও",2947],["رُوَيْدًۢا","ruwaydan","little","কিছুক্ষণের",3584]]}]