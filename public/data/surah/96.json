[{"n":1,"en":"Recite in the name of your Lord who created","bn":"পাঠ কর তোমার প্রতিপালকের নামে যিনি সৃষ্টি করেছেন,","w":[["ٱقْرَأْ","iq'ra","Read","(হে নবী) পড়",598],["بِٱسْمِ","bi-is'mi","in (the) name","নামে",297],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের",13],["ٱلَّذِى","alladhī","the One Who","যিনি",8],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন",60]]},{"n":2,"en":"Created man from a clinging substance.","bn":"সৃষ্টি করেছেন মানুষকে জমাট-বাঁধা রক্তপিন্ড হতে।","w":[["خَلَقَ","khalaqa","He created","সৃষ্টি করেছেন",60],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে",164],["مِنْ","min","from","থেকে",1],["عَلَقٍ","ʿalaqin","a clinging substance","জমাট রক্তপিণ্ড",3899]]},{"n":3,"en":"Recite, and your Lord is the most Generous -","bn":"পাঠ কর, আর তোমার রব বড়ই অনুগ্রহশীল।","w":[["ٱقْرَأْ","iq'ra","Read","পড়",598],["وَرَبُّكَ","warabbuka","and your Lord","আর তোমার রব",13],["ٱلْأَكْرَمُ","l-akramu","(is) the Most Generous","বড়ই অনুগ্রহশীল",2154]]},{"n":4,"en":"Who taught by the pen","bn":"যিনি শিক্ষা দিয়েছেন কলম দিয়ে,","w":[["ٱلَّذِى","alladhī","The One Who","যিনি",8],["عَلَّمَ","ʿallama","taught","শিখিয়েছেন",281],["بِٱلْقَلَمِ","bil-qalami","by the pen","কলম দিয়ে",1610]]},{"n":5,"en":"Taught man that which he knew not.","bn":"শিক্ষা দিয়েছেন মানুষকে যা সে জানত না,","w":[["عَلَّمَ","ʿallama","Taught","শিখিয়েছেন",281],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে (এমন জ্ঞান)",164],["مَا","mā","what","যা",3],["لَمْ","lam","not","না",32],["يَعْلَمْ","yaʿlam","he knew","সে জানতো",29]]},{"n":6,"en":"No! [But] indeed, man transgresses","bn":"না (এমন আচরণ করা) মোটেই ঠিক নয়, মানুষ অবশ্যই সীমালঙ্ঘন করে,","w":[["كَلَّآ","kallā","Nay","কখনও নয়",346],["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষ",164],["لَيَطْغَىٰٓ","layaṭghā","surely transgresses","অবশ্যই সীমালঙ্ঘন করে",732]]},{"n":7,"en":"Because he sees himself self-sufficient.","bn":"কারণ, সে নিজেকে অভাবমুক্ত মনে করে,","w":[["أَن","an","That","(এ কারণে) যে",18],["رَّءَاهُ","raāhu","he sees himself","নিজেকে মনে করে",45],["ٱسْتَغْنَىٰٓ","is'taghnā","self-sufficient","অভাবমুক্ত",1485]]},{"n":8,"en":"Indeed, to your Lord is the return.","bn":"নিঃসন্দেহে (সকলকে) ফিরে যেতে হবে তোমার প্রতিপালকের দিকে।","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["إِلَىٰ","ilā","to","কাছে",15],["رَبِّكَ","rabbika","your Lord","তোমার রবের",13],["ٱلرُّجْعَىٰٓ","l-ruj'ʿā","(is) the return","প্রত্যাবর্তন হবে",3535]]},{"n":9,"en":"Have you seen the one who forbids","bn":"তুমি কি তাকে (অর্থাৎ আবূ জাহলকে) দেখেছ যে নিষেধ করে,","w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি দেখেছ কি",45],["ٱلَّذِى","alladhī","the one who","(তাকে) যে",8],["يَنْهَىٰ","yanhā","forbids","বাধা দেয়",354]]},{"n":10,"en":"A servant when he prays?","bn":"এক বান্দাহকে [অর্থাৎ রসূলুল্লাহ (সা.)-কে] যখন সে নামায আদায় করতে থাকে?","w":[["عَبْدًا","ʿabdan","A slave","এক বান্দাকে",88],["إِذَا","idhā","when","যখন",25],["صَلَّىٰٓ","ṣallā","he prays","সে সালাত পড়ে",731]]},{"n":11,"en":"Have you seen if he is upon guidance","bn":"তুমি কি ভেবে দেখেছ (যাকে নিষেধ করা হচ্ছে) সে যদি সৎ পথে থাকে,","w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি (ভেবে) দেখেছ কি",45],["إِن","in","if","যদি",16],["كَانَ","kāna","he is","সে হয়",10],["عَلَى","ʿalā","upon","উপর",9],["ٱلْهُدَىٰٓ","l-hudā","[the] guidance","সঠিক পথের",126]]},{"n":12,"en":"Or enjoins righteousness?","bn":"আর তাকওয়া অবলম্বনের নির্দেশ দেয় (তাহলে তার এ কাজগুলো কেমন মনে কর?)","w":[["أَوْ","aw","Or","অথবা",41],["أَمَرَ","amara","he enjoins","নির্দেশ দেয়",142],["بِٱلتَّقْوَىٰٓ","bil-taqwā","[of the] righteousness","তাকওয়ার",564]]},{"n":13,"en":"Have you seen if he denies and turns away -","bn":"তোমার কী ধারণা যদি সে (অর্থাৎ নিষেধকারী ব্যক্তি) সত্যকে অস্বীকার করে আর মুখ ফিরিয়ে নেয় (তাহলে তার এ কাজ কেমন মনে কর?)","w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি (ভেবে) দেখেছ কি",45],["إِن","in","if","যদি",16],["كَذَّبَ","kadhaba","he denies","সে মিথ্যা আরোপ করে",64],["وَتَوَلَّىٰٓ","watawallā","and turns away","ও মুখ ফিরায় (কি পরিণাম হবে)",140]]},{"n":14,"en":"Does he not know that Allāh sees?","bn":"সে কি জানে না যে, আল্লাহ দেখেন?","w":[["أَلَمْ","alam","Does not","নাকি",32],["يَعْلَم","yaʿlam","he know","সে জানে",29],["بِأَنَّ","bi-anna","that","যে",30],["ٱللَّهَ","l-laha","Allah","আল্লাহ",2],["يَرَىٰ","yarā","sees","দেখেন (সব কিছু)",45]]},{"n":15,"en":"No! If he does not desist, We will surely drag him by the forelock","bn":"না, (সে যা করতে চায়) তা কক্ষনো করতে পারবে না, সে যদি বিরত না হয় তাহলে আমি অবশ্যই তার মাথার সামনের চুলগুচ্ছ ধরে হেঁচড়ে নিয়ে যাব-","w":[["كَلَّا","kallā","Nay","সাবধান",346],["لَئِن","la-in","If","অবশ্যই যদি",16],["لَّمْ","lam","not","না",32],["يَنتَهِ","yantahi","he desists","সে বিরত হয়",586],["لَنَسْفَعًۢا","lanasfaʿan","surely We will drag him","আমরা অবশ্যই টানবো",4536],["بِٱلنَّاصِيَةِ","bil-nāṣiyati","by the forelock","মাথার সামনের চুল ধরে",2035]]},{"n":16,"en":"A lying, sinning forelock.","bn":"মিথ্যাচারী পাপাচারী চুলগুচ্ছ","w":[["نَاصِيَةٍۢ","nāṣiyatin","A forelock","সামনের চুল (টানবো)",2035],["كَـٰذِبَةٍ","kādhibatin","lying","মিথ্যুকের",352],["خَاطِئَةٍۢ","khāṭi-atin","sinful","পাপীর",2332]]},{"n":17,"en":"Then let him call his associates;","bn":"কাজেই সে তার সভাষদদের ডাকুক।","w":[["فَلْيَدْعُ","falyadʿu","Then let him call","অতএব সে যেন ডাকে",65],["نَادِيَهُۥ","nādiyahu","his associates","তার দোসরদেরকে",2711]]},{"n":18,"en":"We will call the angels of Hell.","bn":"আমিও ‘আযাবের ফেরেশতাদেরকে ডাকব,","w":[["سَنَدْعُ","sanadʿu","We will call","আমরা শীঘ্র ডাকবো",65],["ٱلزَّبَانِيَةَ","l-zabāniyata","the Angels of Hell","জাহান্নামের প্রহরীদেরকে",3593]]},{"n":19,"en":"No! Do not obey him. But prostrate and draw near [to Allāh].","bn":"না, তুমি কক্ষনো তার অনুসরণ করো না, তুমি সাজদাহ কর আর (আল্লাহর) নৈকট্য লাভ কর।[সাজদাহ]","w":[["كَلَّا","kallā","Nay","কখনও নয় (সাবধান)",346],["لَا","lā","(Do) not","না",5],["تُطِعْهُ","tuṭiʿ'hu","obey him","তাকে অনুসরণ করো",158],["وَٱسْجُدْ","wa-us'jud","But prostrate","এবং তুমি সিজদা করো",331],["وَٱقْتَرِب ۩","wa-iq'tarib","and draw near (to Allah)","ও নৈকট্য লাভ করো (তোমার রবের)",1280]]}]