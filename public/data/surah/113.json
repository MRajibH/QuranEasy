[{"n":1,"en":"Say, \"I seek refuge in the Lord of daybreak","bn":"বল, ‘আমি আশ্রয় চাচ্ছি সকাল বেলার রব-এর,","w":[["قُلْ","qul","Say","বলো",7],["أَعُوذُ","aʿūdhu","I seek refuge","আমি আশ্রয় চাই",840],["بِرَبِّ","birabbi","in (the) Lord","স্রষ্টার নিকট",13],["ٱلْفَلَقِ","l-falaqi","(of) the dawn","প্রভাতের",3991]]},{"n":2,"en":"From the evil of that which He created","bn":"তিনি যা সৃষ্টি করেছেন তার অনিষ্ট হতে,","w":[["مِن","min","From","হতে",1],["شَرِّ","sharri","(the) evil","অনিষ্ট",363],["مَا","mā","(of) what","যা",3],["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন",60]]},{"n":3,"en":"And from the evil of darkness when it settles","bn":"আর অন্ধকার রাতের অনিষ্ট হতে যখন তা আচ্ছন্ন হয়ে যায়।","w":[["وَمِن","wamin","And from","এবং হতে",1],["شَرِّ","sharri","(the) evil","অনিষ্ট",363],["غَاسِقٍ","ghāsiqin","(of) darkness","রাতের অন্ধকারের",3914],["إِذَا","idhā","when","যখন",25],["وَقَبَ","waqaba","it spreads","তা গভীর হয়",4653]]},{"n":4,"en":"And from the evil of the blowers in knots","bn":"এবং (জাদু করার উদ্দেশ্যে) গিরায় ফুৎকারকারিণীদের অনিষ্ট হতে,","w":[["وَمِن","wamin","And from","এবং হতে",1],["شَرِّ","sharri","(the) evil","অনিষ্ট",363],["ٱلنَّفَّـٰثَـٰتِ","l-nafāthāti","(of) the blowers","ফুঁকদানকারীর (রাতের) অনিষ্ট",4558],["فِى","fī","in","মধ্যে",4],["ٱلْعُقَدِ","l-ʿuqadi","the knots","গিঁটগুলোর",1583]]},{"n":5,"en":"And from the evil of an envier when he envies.\"","bn":"এবং হিংসুকের অনিষ্ট হতে, যখন সে হিংসা করে।","w":[["وَمِن","wamin","And from","এবং হতে",1],["شَرِّ","sharri","(the) evil","অনিষ্ট",363],["حَاسِدٍ","ḥāsidin","(of) an envier","হিংসুকের",3362],["إِذَا","idhā","when","যখন",25],["حَسَدَ","ḥasada","he envies","সে হিংসা করে",1813]]}]