[{"n":1,"en":"By the racers, panting,","bn":"শপথ সেই (ঘোড়া) গুলোর যারা ঊর্ধ্বশ্বাসে দৌড়ায়,","w":[["وَٱلْعَـٰدِيَـٰتِ","wal-ʿādiyāti","By the racers","শপথ ধাবমান (ঘোড়াগুলোর)",3846],["ضَبْحًۭا","ḍabḥan","panting","(যারা দৌঁড়ায়) উর্ধ্বশ্বাসে",3801]]},{"n":2,"en":"And the producers of sparks [when] striking","bn":"অতঃপর (নিজের ক্ষুরের) ঘর্ষণে আগুন ছুটায়,","w":[["فَٱلْمُورِيَـٰتِ","fal-mūriyāti","And the producers of sparks","অতঃপর যারা বিচ্ছুরিত করে",4474],["قَدْحًۭا","qadḥan","striking","(ক্ষুরাঘাতে) আগুনের ফুলকি",4019]]},{"n":3,"en":"And the chargers at dawn,","bn":"অতঃপর সকালে হঠাৎ আক্রমণ চালায়,","w":[["فَٱلْمُغِيرَٰتِ","fal-mughīrāti","And the chargers","অতঃপর যারা অভিযান চালায়",4360],["صُبْحًۭا","ṣub'ḥan","(at) dawn","প্রভাতে",1356]]},{"n":4,"en":"Stirring up thereby [clouds of] dust,","bn":"আর সে সময় ধূলি উড়ায়,","w":[["فَأَثَرْنَ","fa-atharna","Then raise","অতঃপর উড়ায়",1260],["بِهِۦ","bihi","thereby","এভাবে",20],["نَقْعًۭا","naqʿan","dust","ধুলোবালি",4571]]},{"n":5,"en":"Arriving thereby in the center collectively,","bn":"অতঃপর (শত্রু) দলের অভ্যন্তরে ঢুকে পড়ে (এভাবে মানুষ নিজের শক্তি-সামর্থ্য ও আল্লাহর এক অতি বড় নি‘মাত ঘোড়াকে অপরের সম্পদ লুণ্ঠন ও অন্যের প্রতি যুলমের কাজে ব্যবহার করে),","w":[["فَوَسَطْنَ","fawasaṭna","Then penetrate (in the) center","অতঃপর (ঢুকে পড়ে) অভ্যন্তরে",4641],["بِهِۦ","bihi","thereby","এভাবে",20],["جَمْعًا","jamʿan","collectively","(শত্রু)দলে",677]]},{"n":6,"en":"Indeed mankind, to his Lord, is ungrateful.","bn":"বস্তুতঃ মানুষ তার রব-এর প্রতি বড়ই অকৃতজ্ঞ।","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["ٱلْإِنسَـٰنَ","l-insāna","mankind","মানুষ",164],["لِرَبِّهِۦ","lirabbihi","to his Lord","তার রবের প্রতি",13],["لَكَنُودٌۭ","lakanūdun","(is) surely ungrateful","অবশ্যই অকৃতজ্ঞ",4080]]},{"n":7,"en":"And indeed, he is to that a witness.","bn":"আর সে নিজেই (নিজের কাজ-কর্মের মাধ্যমে) এ বিষয়ের সাক্ষী।","w":[["وَإِنَّهُۥ","wa-innahu","And indeed, he","এবং সে নিশ্চয়ই",6],["عَلَىٰ","ʿalā","on","বিষয়ে",9],["ذَٰلِكَ","dhālika","that","এর",12],["لَشَهِيدٌۭ","lashahīdun","surely (is) a witness","অবশ্যই সাক্ষী",206]]},{"n":8,"en":"And indeed he is, in love of wealth, intense.","bn":"আর ধন-সম্পদের প্রতি অবশ্যই সে খুবই আসক্ত।","w":[["وَإِنَّهُۥ","wa-innahu","And indeed he","এবং নিশ্চয়ই সে",6],["لِحُبِّ","liḥubbi","in (the) love","মহব্বতের ক্ষেত্রে",891],["ٱلْخَيْرِ","l-khayri","(of) wealth","ধন-সম্পদের",62],["لَشَدِيدٌ","lashadīdun","(is) surely intense","বড়ই প্রবল",205]]},{"n":9,"en":"But does he not know that when the contents of the graves are scattered","bn":"সে কি জানে না, কবরে যা আছে তা যখন উত্থিত হবে,","w":[["۞ أَفَلَا","afalā","But does not","তবে কি না",5],["يَعْلَمُ","yaʿlamu","he know","সে জানে",29],["إِذَا","idhā","when","যখন",25],["بُعْثِرَ","buʿ'thira","will be scattered","উঠানো হবে",2231],["مَا","mā","what","যা কিছু",3],["فِى","fī","(is) in","মধ্যে আছে",4],["ٱلْقُبُورِ","l-qubūri","the graves","কবরগুলোর",1209]]},{"n":10,"en":"And that within the breasts is obtained,","bn":"আর অন্তরে যা (কিছু লুকানো) আছে তা প্রকাশ করা হবে,","w":[["وَحُصِّلَ","waḥuṣṣila","And is made apparent","এবং প্রকাশ করা হবে",3399],["مَا","mā","what","যা কিছু",3],["فِى","fī","(is) in","মধ্যে আছে",4],["ٱلصُّدُورِ","l-ṣudūri","the breasts","অন্তরসমূহের",262]]},{"n":11,"en":"Indeed, their Lord with them, that Day, is [fully] Aware.","bn":"নিঃসন্দেহে তাদের প্রতিপালক সেদিন তাদের সম্পর্কে পুরোপুরি অবহিত থাকবেন।","w":[["إِنَّ","inna","Indeed","নিশ্চয়ই",6],["رَبَّهُم","rabbahum","their Lord","তাদের রব",13],["بِهِمْ","bihim","about them","তাদের সাথে",20],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন",22],["لَّخَبِيرٌۢ","lakhabīrun","(is) surely All-Aware","অবশ্যই তা ভালো করেই জানেন",253]]}]