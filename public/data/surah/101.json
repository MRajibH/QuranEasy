[{"n":1,"en":"The Striking Calamity -","bn":"মহা বিপদ","w":[["ٱلْقَارِعَةُ","al-qāriʿatu","The Striking Calamity","মহাপ্রলয়",1387]]},{"n":2,"en":"What is the Striking Calamity?","bn":"কী সেই মহা বিপদ?","w":[["مَا","mā","What","কি সেই",3],["ٱلْقَارِعَةُ","l-qāriʿatu","(is) the Striking Calamity","মহাপ্রলয়",1387]]},{"n":3,"en":"And what can make you know what is the Striking Calamity?","bn":"মহা বিপদ সম্পর্কে তুমি কী জান?","w":[["وَمَآ","wamā","And what","এবং কিসে",3],["أَدْرَىٰكَ","adrāka","will make you know","তোমাকে জানাবে",554],["مَا","mā","what","মহাপ্রলয়",3],["ٱلْقَارِعَةُ","l-qāriʿatu","(is) the Striking Calamity","ভয়াবহ দুর্ঘটনা",1387]]},{"n":4,"en":"It is the Day when people will be like moths, dispersed,","bn":"সে দিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত","w":[["يَوْمَ","yawma","(The) Day","সেদিন",22],["يَكُونُ","yakūnu","will be","হবে",10],["ٱلنَّاسُ","l-nāsu","the mankind","মানুষ",51],["كَٱلْفَرَاشِ","kal-farāshi","like moths","পতঙ্গের মতো",3968],["ٱلْمَبْثُوثِ","l-mabthūthi","scattered","বিক্ষিপ্ত",4131]]},{"n":5,"en":"And the mountains will be like wool, fluffed up.","bn":"আর পর্বতগুলো হবে ধুনা রঙ্গিন পশমের মত।","w":[["وَتَكُونُ","watakūnu","And will be","এবং হবে",10],["ٱلْجِبَالُ","l-jibālu","the mountains","পাহাড়সমূহ",298],["كَٱلْعِهْنِ","kal-ʿih'ni","like wool","রঙিন পশমের মতো",2533],["ٱلْمَنفُوشِ","l-manfūshi","fluffed up","ধুনিত",4447]]},{"n":6,"en":"Then as for one whose scales are heavy [with good deeds],","bn":"অতঃপর যার (সৎ কর্মের) পাল্লা ভারি হবে।","w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর তার (ব্যাপার)",209],["مَن","man","(him) whose","যার",14],["ثَقُلَتْ","thaqulat","(are) heavy","ভারী হবে",1505],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার (পূণ্যের) পাল্লাসমূহ",602]]},{"n":7,"en":"He will be in a pleasant life.","bn":"সে সুখী জীবন যাপন করবে।","w":[["فَهُوَ","fahuwa","Then he","সে অতঃপর থাকবে",109],["فِى","fī","(will be) in","মধ্যে",4],["عِيشَةٍۢ","ʿīshatin","a life","জীবনের",2534],["رَّاضِيَةٍۢ","rāḍiyatin","pleasant","সন্তোষজনক",1533]]},{"n":8,"en":"But as for one whose scales are light,","bn":"আর যার (সৎকর্মের) পাল্লা হালকা হবে,","w":[["وَأَمَّا","wa-ammā","But as for","আর (তার) ব্যাপার",209],["مَنْ","man","(him) whose","যার",14],["خَفَّتْ","khaffat","(are) light","হালকা হবে",1831],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার পাল্লাসমূহ নেকীর",602]]},{"n":9,"en":"His refuge will be an abyss.","bn":"(জাহান্নামের) অতলস্পর্শী গর্তই হবে তার বাসস্থান।","w":[["فَأُمُّهُۥ","fa-ummuhu","His abode","অতঃপর তার বাসস্থান",337],["هَاوِيَةٌۭ","hāwiyatun","(will be the) Pit","গভীর গর্ত হবে",4592]]},{"n":10,"en":"And what can make you know what that is?","bn":"তুমি কি জান তা কী?","w":[["وَمَآ","wamā","And what","এবং কিসে",3],["أَدْرَىٰكَ","adrāka","will make you know","তোমাকে জানাবে",554],["مَا","mā","what","কি",3],["هِيَهْ","hiyah","it is","সেটা",4614]]},{"n":11,"en":"It is a Fire, intensely hot.","bn":"জ্বলন্ত আগুন।","w":[["نَارٌ","nārun","A Fire","(সেটা হলো) আগুন",78],["حَامِيَةٌۢ","ḥāmiyatun","intensely hot","গণগণে",2316]]}]