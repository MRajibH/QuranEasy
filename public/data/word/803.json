{"id":803,"ar":"يَسَّرَ","tr":"","bn":"আমরা সহজ করেছি","en":"We have made easy","root":"ي س ر","freq":11,"g":{"kind":"verb","vf":2,"tense":{"PERF":["يَسَّرْنَا",7],"IMPV":["وَيَسِّرْ",1],"IMPF":["فَسَنُيَسِّرُهُۥ",3]}},"forms":[{"ar":"يَسَّرْنَا","n":4,"en":"We have made easy","bn":"আমরা সহজ করে দিয়েছি","tr":"yassarnā"},{"ar":"يَسَّرْنَـٰهُ","n":2,"en":"We (have) made it easy","bn":"তা আমরা সহজ করেছি","tr":"yassarnāhu"},{"ar":"فَسَنُيَسِّرُهُۥ","n":2,"en":"Then We will ease him","bn":"আমরা তাকে সহজতা দিব","tr":"fasanuyassiruhu"},{"ar":"وَيَسِّرْ","n":1,"en":"And ease","bn":"এবং সহজ করো","tr":"wayassir"},{"ar":"يَسَّرَهُۥ","n":1,"en":"He made easy for him","bn":"তার (জন্যে) সহজ করেছেন","tr":"yassarahu"},{"ar":"وَنُيَسِّرُكَ","n":1,"en":"And We will ease you","bn":"এবং আমরা তোমাকে সহজ করে দিবো","tr":"wanuyassiruka"}],"family":[[637,"يَسِير","সহজ","easy",15],[1122,"يُسْر","স্বস্তি (আছে)","(with) ease",7],[2032,"مَيْسِر","ও জুয়া (খেলা)","and [the] games of chance",3],[2200,"اسْتَيْسَرَ","সহজলভ্য হয়","(can be) obtained with ease",2],[2286,"تَيَسَّرَ","সহজসাধ্য হয়","is easy",2],[2800,"يُسْرَى","সহজ (পন্থাকে)","to the ease",2],[4491,"مَيْسَرَة","সচ্ছলতা","ease",1],[4492,"مَيْسُور","সহজভাবে","gentle",1]],"ant":[],"syn":[],"examples":[{"ref":"20:26","w":["وَيَسِّرْ","لِىٓ","أَمْرِى"],"hi":0,"en":"And ease for me my task","bn":"আর আমার জন্য আমার কাজকে সহজ করে দাও।"},{"ref":"80:20","w":["ثُمَّ","ٱلسَّبِيلَ","يَسَّرَهُۥ"],"hi":2,"en":"Then He eased the way for him;","bn":"অতঃপর তিনি (উপায়-উপকরণ ও প্রয়োজনীয় দ্রব্যসামগ্রী দিয়ে জীবনে চলার জন্য) তার পথ সহজ করে দিয়েছেন।"},{"ref":"44:58","w":["فَإِنَّمَا","يَسَّرْنَـٰهُ","بِلِسَانِكَ","لَعَلَّهُمْ","يَتَذَكَّرُونَ"],"hi":1,"en":"And indeed, We have eased it [i.e., the Qur’ān] in your tongue that they might be reminded.","bn":"আমি তোমার ভাষায় কুরআনকে সহজ করে দিয়েছি যাতে তারা উপদেশ গ্রহণ করে।"}]}