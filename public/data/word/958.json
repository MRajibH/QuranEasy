{"id":958,"ar":"اشْتَهَتْ","tr":"ish'tahat","bn":"চাইবে","en":"desire","root":"ش ه و","freq":8,"audio":"21:102:7","g":{"kind":"verb","vf":8,"tense":{"IMPF":["تَشْتَهِىٓ",7],"PERF":["ٱشْتَهَتْ",1]}},"forms":[{"ar":"يَشْتَهُونَ","n":5,"en":"they desire","bn":"তারা কামনা করে","tr":"yashtahūna","loc":"16:57:7"},{"ar":"ٱشْتَهَتْ","n":1,"en":"desire","bn":"চাইবে","tr":"ish'tahat","loc":"21:102:7"},{"ar":"تَشْتَهِىٓ","n":1,"en":"desire","bn":"চায়","tr":"tashtahī","loc":"41:31:11"},{"ar":"تَشْتَهِيهِ","n":1,"en":"desires","bn":"তা চাইবে","tr":"tashtahīhi","loc":"43:71:9"}],"family":[[1887,"شَهَوَة","কুপ্রবৃত্তির","(of) the (things they) desire",3,"3:14:4"],[2452,"شَهْوَة","যৌন-তৃপ্তির জন্যে","lustfully",2,"7:81:4"]],"ant":[],"syn":[],"examples":[{"ref":"77:42","w":["وَفَوَٰكِهَ","مِمَّا","يَشْتَهُونَ"],"hi":2,"en":"And fruits from whatever they desire,","bn":"আর তাদের জন্য থাকবে ফলমূল- যেটি তাদের মন চাইবে।"},{"ref":"56:21","w":["وَلَحْمِ","طَيْرٍۢ","مِّمَّا","يَشْتَهُونَ"],"hi":3,"en":"And the meat of fowl, from whatever they desire.","bn":"আর পাখীর গোশত যেটা তাদের মনে চাইবে,"},{"ref":"52:22","w":["وَأَمْدَدْنَـٰهُم","بِفَـٰكِهَةٍۢ","وَلَحْمٍۢ","مِّمَّا","يَشْتَهُونَ"],"hi":4,"en":"And We will provide them with fruit and meat from whatever they desire.","bn":"আমি তাদেরকে দিব ফলমূল আর গোশত যা তারা পছন্দ করবে।"}]}