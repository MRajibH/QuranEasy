{"id":510,"ar":"عَرَفَ","tr":"taʿrifu","bn":"তুমি লক্ষ্য করবে","en":"you will recognize","root":"ع ر ف","freq":20,"audio":"22:72:6","g":{"kind":"verb","vf":1,"tense":{"PERF":["عَرَفُوا۟",4],"IMPF":["تَعْرِفُ",16]}},"forms":[{"ar":"يَعْرِفُونَ","n":4,"en":"they recognize","bn":"তারা চিনে","tr":"yaʿrifūna","loc":"2:146:6"},{"ar":"عَرَفُوا۟","n":2,"en":"they recognized","bn":"তারা জানত","tr":"ʿarafū","loc":"2:89:20"},{"ar":"يَعْرِفُونَهُۥ","n":2,"en":"they recognize it","bn":"তা তারা চিনে","tr":"yaʿrifūnahu","loc":"2:146:4"},{"ar":"تَعْرِفُ","n":2,"en":"you will recognize","bn":"তুমি লক্ষ্য করবে","tr":"taʿrifu","loc":"22:72:6"},{"ar":"تَعْرِفُهُم","n":1,"en":"you recognize them","bn":"তাদেরকে তুমি চিনবে","tr":"taʿrifuhum","loc":"2:273:17"},{"ar":"يَعْرِفُونَهُم","n":1,"en":"whom they recognize","bn":"তারা চিনবে তাদের","tr":"yaʿrifūnahum","loc":"7:48:5"}],"family":[[307,"مَعْرُوف","সদ্ভাবে","kind",38,"4:5:16"],[1752,"اعْتَرَفُ","তারা স্বীকার করেছে","(who have) acknowledged",3,"9:102:2"],[2144,"أَعْراف","আ'রাফের","the heights",2,"7:46:4"],[2513,"عَرَّفَ","(নবী) ব্যক্ত করল","he made known",2,"66:3:14"],[2514,"عُرْف","কল্যাণ সুরূপ","one after another",2,"77:1:2"],[2771,"يَتَعارَفُ","তারা পরস্পরে চিনবে","they will recognize each other",2,"10:45:10"],[3868,"عَرَفات","আরাফাত","(Mount) Arafat",1,"2:198:12"],[4337,"مَعْرُوفَة","যথার্থই (কাম্য)","(is) known",1,"24:53:12"]],"ant":[],"syn":[],"examples":[{"ref":"83:24","w":["تَعْرِفُ","فِى","وُجُوهِهِمْ","نَضْرَةَ","ٱلنَّعِيمِ"],"hi":0,"en":"You will recognize in their faces the radiance of pleasure.","bn":"তুমি তাদের মুখে আরাম আয়েশের উজ্জ্বলতা দেখতে পাবে।"},{"ref":"55:41","w":["يُعْرَفُ","ٱلْمُجْرِمُونَ","بِسِيمَـٰهُمْ","فَيُؤْخَذُ","بِٱلنَّوَٰصِى","وَٱلْأَقْدَامِ"],"hi":0,"en":"The criminals will be known by their marks, and they will be seized by the forelocks and the feet.","bn":"অপরাধীদেরকে চিনতে পারা যাবে তাদের চেহারা থেকেই, আর মাথার ঝুঁটি ও পা ধরে তাদেরকে পাকড়াও করা হবে।"},{"ref":"16:83","w":["يَعْرِفُونَ","نِعْمَتَ","ٱللَّ