{"id":497,"ar":"أَقْسَمُ","tr":"uq'simu","bn":"আমি শপথ করছি","en":"I swear","root":"ق س م","freq":20,"g":{"kind":"verb","vf":4,"tense":{"PERF":["وَأَقْسَمُوا۟",8],"IMPF":["أُقْسِمُ",12]}},"forms":[{"ar":"أُقْسِمُ","n":8,"en":"I swear","bn":"শপথ করছি আমি","tr":"uq'simu"},{"ar":"وَأَقْسَمُوا۟","n":3,"en":"And they swear","bn":"এবং তারা শপথ করে বলে","tr":"wa-aqsamū"},{"ar":"أَقْسَمُوا۟","n":2,"en":"swore","bn":"শপথ করেছিলো (বিশ্বাস করাতো)","tr":"aqsamū"},{"ar":"فَيُقْسِمَانِ","n":2,"en":"and let them both swear","bn":"অতঃপর উভয় শপথ করবে","tr":"fayuq'simāni"},{"ar":"أَقْسَمْتُمْ","n":1,"en":"you had sworn","bn":"তোমরা শপথ করে বলতে (যে)","tr":"aqsamtum"},{"ar":"أَقْسَمْتُم","n":1,"en":"sworn","bn":"তোমরা শপথ","tr":"aqsamtum"}],"family":[[1953,"قِسْمَة","বণ্টন","(is) a division",3],[2569,"قَسَم","কোনো শপথ (কোনো প্রমাণ)","(not) an oath",2],[2570,"قَسَمْ","বণ্টন করে","distribute",2],[3194,"تَسْتَقْسِمُ","তোমরা ভাগ্য নির্ণয় করো","you seek division",1],[3255,"تَقاسَمُ","তোমরা শপথ করো পরস্পরে","Swear to each other",1],[4001,"قاسَمَ","এবং তাদের দুজনের কাছে সে শপথ করলে","And he swore (to) both of them",1],[4380,"مُقْتَسِم","বিভক্তকারীদের","those who divided",1],[4386,"مُقَسِّمَة","অতঃপর বণ্টনকারীর","And those distributing",1]],"ant":[],"syn":[],"examples":[{"ref":"81:15","w":["فَلَآ","أُقْسِمُ","بِٱلْخُنَّسِ"],"hi":1,"en":"So I swear by the retreating stars -","bn":"আমি শপথ করছি (গ্রহের) যা পেছনে সরে যায়,"},{"ref":"84:16","w":["فَلَآ","أُقْسِمُ","بِٱلشَّفَقِ"],"hi":1,"en":"So I swear by the twilight glow","bn":"আমি শপথ করি সন্ধ্যাকালীন লালিমার,"},{"ref":"56:75","w":["۞ فَلَآ","أُقْسِمُ","بِمَوَٰقِعِ","ٱلنُّجُومِ"],"hi":1,"en":"Then I swear by the setting of the stars,","bn":"উপরন্তু আমি শপথ করছি তারকারাজির অস্তাচলের।"}]}