{"id":33,"ar":"جَعَلَ","tr":"jaʿala","bn":"বানানো, করা","en":"to make","root":"ج ع ل","freq":340,"audio":"2:22:2","g":{"kind":"verb","vf":1,"tense":{"IMPF":["يَجْعَلَ",83],"PERF":["جَعَلَ",235],"IMPV":["ٱجْعَلْ",22]}},"forms":[{"ar":"جَعَلَ","n":43,"en":"made","bn":"করেছেন","tr":"jaʿala","loc":"2:22:2"},{"ar":"وَجَعَلْنَا","n":36,"en":"and We made","bn":"ও আমরা করেছি","tr":"wajaʿalnā","loc":"5:13:5"},{"ar":"وَجَعَلَ","n":29,"en":"and made","bn":"ও বানিয়েছেন","tr":"wajaʿala","loc":"5:60:15"},{"ar":"جَعَلْنَا","n":28,"en":"We made","bn":"আমরা নির্দিষ্ট করেছলাম","tr":"jaʿalnā","loc":"2:125:2"},{"ar":"جَعَلْنَـٰهُ","n":7,"en":"We had made him","bn":"আমরা করতাম তাকে","tr":"jaʿalnāhu","loc":"6:9:2"},{"ar":"وَجَعَلُوا۟","n":7,"en":"And they make","bn":"এবং তারা বানিয়েছে","tr":"wajaʿalū","loc":"6:100:1"}],"family":[[1156,"جاعِل","সৃষ্টিকারী","going to place",6,"2:30:6"]],"ant":[],"syn":[],"examples":[{"ref":"68:35","w":["أَفَنَجْعَلُ","ٱلْمُسْلِمِينَ","كَٱلْمُجْرِمِينَ"],"hi":0,"en":"Then will We treat the Muslims like the criminals?","bn":"আমি কি আত্মসমর্পণকারীদেরকে অপরাধীদের মত গণ্য করব?"},{"ref":"78:9","w":["وَجَعَلْنَا","نَوْمَكُمْ","سُبَاتًۭا"],"hi":0,"en":"And made your sleep [a means for] rest","bn":"আর তোমাদের নিদ্রাকে করেছি বিশ্রামদায়ী।"},{"ref":"78:10","w":["وَجَعَلْنَا","ٱلَّيْلَ","لِبَاسًۭا"],"hi":0,"en":"And made the night as clothing.","bn":"রাতকে করেছি আবরণ,"}]}