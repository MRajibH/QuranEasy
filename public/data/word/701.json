{"id":701,"ar":"أَخْزَيْ","tr":"yukh'zī","bn":"লাঞ্চিত করবেন","en":"will be disgraced","root":"خ ز ي","freq":12,"audio":"66:8:23","g":{"kind":"verb","vf":4,"tense":{"PERF":["أَخْزَيْتَهُۥ ۖ",1],"IMPF":["يُخْزِى",11]}},"forms":[{"ar":"يُخْزِيهِ","n":3,"en":"(that) will disgrace him","bn":"যা তাকে লাঞ্ছিত করবে","tr":"yukh'zīhi","loc":"11:39:6"},{"ar":"تُخْزُونِ","n":2,"en":"disgrace me","bn":"আমাকে লজ্জিত করো","tr":"tukh'zūni","loc":"11:78:20"},{"ar":"أَخْزَيْتَهُۥ ۖ","n":1,"en":"You (have) disgraced him","bn":"তাকে তুমি অপমান করলে","tr":"akhzaytahu","loc":"3:192:7"},{"ar":"تُخْزِنَا","n":1,"en":"disgrace us","bn":"আমাদেরকে অপমান করো","tr":"tukh'zinā","loc":"3:194:8"},{"ar":"وَيُخْزِهِمْ","n":1,"en":"and disgrace them","bn":"এবং লাঞ্ছিত করবেন তাদেরকে","tr":"wayukh'zihim","loc":"9:14:5"},{"ar":"يُخْزِيهِمْ","n":1,"en":"He will disgrace them","bn":"তিনি লাঞ্ছিত করবেন তাদের","tr":"yukh'zīhim","loc":"16:27:4"}],"family":[[765,"خِزْى","অপমান","(is) disgrace",11,"2:85:35"],[2869,"أَخْزَى","অধিক অপমানকর","(is) more disgracing",1,"41:16:16"],[4199,"مُخْزِي","লাঞ্ছনাকারী","(is) the One Who (will) disgrace",1,"9:2:13"],[4525,"نَخْزَى","ও আমরা অপমানিত হতাম","and disgraced",1,"20:134:19"]],"ant":[],"syn":[],"examples":[{"ref":"15:69","w":["وَٱتَّقُوا۟","ٱللَّهَ","وَلَا","تُخْزُونِ"],"hi":3,"en":"And fear Allāh and do not disgrace me.\"","bn":"তোমরা আল্লাহকে ভয় কর, আমাকে লজ্জিত করো না।’"},{"ref":"26:87","w":["وَلَا","تُخْزِنِى","يَوْمَ","يُبْعَثُونَ"],"hi":1,"en":"And do not disgrace me on the Day they are [all] resurrected -","bn":"এবং পুনরুত্থান দিবসে আমাকে অপমানিত করো না।"},{"ref":"39:40","w":["مَن","يَأْتِيهِ","عَذَابٌۭ","يُخْزِيهِ","وَيَحِلُّ","عَلَيْهِ","عَذَابٌۭ","مُّقِيمٌ"],"hi":3,"en":"To whom will come a torment disgracing him and on whom will descend an enduring punishment.\"","bn":"কার উপর আসে অপমানজনক শাস্তি, আর কার উপর পতিত হয় স্থায়ী ‘আযাব।"}]}