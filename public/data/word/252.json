{"id":252,"ar":"حَكَمَ","tr":"yaḥkumu","bn":"বিচার করে","en":"will judge","root":"ح ك م","freq":45,"audio":"2:113:24","g":{"kind":"verb","vf":1,"tense":{"IMPF":["يَحْكُمُ",35],"PERF":["حَكَمَ",3],"IMPV":["ٱحْكُم",7]}},"forms":[{"ar":"يَحْكُمُ","n":10,"en":"will judge","bn":"মীমাংসা করবেন","tr":"yaḥkumu","loc":"2:113:24"},{"ar":"فَٱحْكُم","n":5,"en":"then judge","bn":"তবে বিচার করে দাও","tr":"fa-uḥ'kum","loc":"5:42:7"},{"ar":"لِيَحْكُمَ","n":4,"en":"to judge","bn":"তিনি মীমাংসা করতে পারেন যাতে","tr":"liyaḥkuma","loc":"2:213:14"},{"ar":"يَحْكُمُونَ","n":4,"en":"they judge","bn":"তারা মীমাংসা করে","tr":"yaḥkumūna","loc":"6:136:31"},{"ar":"تَحْكُمُونَ","n":4,"en":"you judge","bn":"তোমরা বিচার করো","tr":"taḥkumūna","loc":"10:35:29"},{"ar":"يَحْكُم","n":3,"en":"judge","bn":"বিচার করে","tr":"yaḥkum","loc":"5:44:35"}],"family":[[112,"حَكِيم","প্রজ্ঞাময়","All-Wise",97,"2:220:26"],[361,"حُكْم","প্রজ্ঞা","wisdom",30,"5:50:8"],[504,"حِكْمَة","প্রজ্ঞা","Wisdom",20,"54:5:1"],[1313,"حاكِم","মীমাংসাকারীদের","(of) the Judges",5,"7:87:19"],[1817,"حَكَم","একজন সালিশ","an arbitrator",3,"4:35:6"],[2113,"أَحْكَم","উত্তম বিচারক","(are) the Most Just",2,"11:45:14"],[2114,"أُحْكِمَتْ","সুপ্রতিষ্ঠিত করা হয়েছে","are perfected",2,"11:1:3"],[2627,"مُحْكَمَة","মুহকাম (সুদৃঢ়)","absolutely clear",2,"3:7:8"]],"ant":[],"syn":[],"examples":[{"ref":"37:154","w":["مَا","لَكُمْ","كَيْفَ","تَحْكُمُونَ"],"hi":3,"en":"What is [wrong] with you? How do you make judgement?","bn":"তোমাদের কী হয়েছে, তোমরা কেমন ফয়সালা করছ?"},{"ref":"22:69","w":["ٱللَّهُ","يَحْكُمُ","بَيْنَكُمْ","يَوْمَ","ٱلْقِيَـٰمَةِ","فِيمَا","كُنتُمْ","فِيهِ","تَخْتَلِفُونَ"],"hi":1,"en":"Allāh will judge between you on the Day of Resurrection concerning that over which you used to differ.\"","bn":"আল্লাহ কিয়ামাতের দিন সে বিষয়ে তোমাদের মধ্যে মীমাংসা করে দিবেন যে বিষয়ে তোমরা মতভেদ করছ।"},{"ref":"21:112","w":["قَـٰلَ","رَبِّ","ٱحْكُم","بِٱلْحَقِّ ۗ","وَرَبُّنَا","ٱلرَّحْمَـٰنُ","ٱلْمُسْتَعَانُ","عَلَىٰ","مَا","تَصِفُونَ"],"hi":2,"en":"[The Prophet (ﷺ)] has said, \"My Lord, judge [between us] in truth. And our Lord is the Most Merciful, the one whose help is sought against that which you describe.\"","bn":"রসূল বলেছিল- হে আমার প্রতিপালক! তুমি ন্যায্য মীমাংসা করে দাও, আর আমাদের প্রতিপালক তো দয়ার আধার। তোমরা (তাঁর বিরুদ্ধে) যে সব কথা বলছ সে বিষয়ে তিনিই একমাত্র আশ্রয়স্থল।"}]}