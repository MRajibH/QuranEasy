{"id":259,"ar":"أَنذَرَ","tr":"tundhiru","bn":"সতর্ক করো","en":"Warn","root":"ن ذ ر","freq":44,"audio":"35:18:20","g":{"kind":"verb","vf":4,"tense":{"PERF":["أُنذِرَ",10],"IMPF":["تُنذِرُ",25],"IMPV":["أَنذِرِ",9]}},"forms":[{"ar":"لِتُنذِرَ","n":4,"en":"that you warn","bn":"যেন তুমি সতর্ক করো","tr":"litundhira","loc":"7:2:10"},{"ar":"لِّيُنذِرَ","n":3,"en":"to warn","bn":"জন্যে সতর্ক করার","tr":"liyundhira","loc":"18:2:2"},{"ar":"ءَأَنذَرْتَهُمْ","n":2,"en":"whether you warn them","bn":"তাদের তুমি সতর্ক কর কি","tr":"a-andhartahum","loc":"2:6:6"},{"ar":"تُنذِرْهُمْ","n":2,"en":"you warn them","bn":"সতর্ক কর তুমি তাদেরকে","tr":"tundhir'hum","loc":"2:6:9"},{"ar":"وَأَنذِرْ","n":2,"en":"And warn","bn":"আর (হে নাবী) তুমি সতর্ক করো","tr":"wa-andhir","loc":"6:51:1"},{"ar":"وَيُنذِرُونَكُمْ","n":2,"en":"and warning you","bn":"এবং তারা সতর্ক করতো তোমাদেরকে","tr":"wayundhirūnakum","loc":"6:130:11"}],"family":[[199,"نَذِير","সতর্ককারী","a warner",58,"7:184:10"],[632,"مُنذِر","একজন সতর্ককারী","a warner",15,"13:7:12"],[1415,"مُنذَر","যাদের সতর্ক করা হয়েছিলো","(of) those who were warned",5,"10:73:17"],[1657,"نَذَرْ","তোমরা মানত কর","you vow",4,"3:35:7"],[2720,"نَذْر","মানত","vow(s)",2,"2:270:8"],[4528,"نُذْر","সতর্কতা সুরূপ","warning",1,"77:6:3"],[4530,"نُذُور","তাদের মানতগুলোকে","their vows",1,"22:29:5"]],"ant":[],"syn":[],"examples":[{"ref":"26:214","w":["وَأَنذِرْ","عَشِيرَتَكَ","ٱلْأَقْرَبِينَ"],"hi":0,"en":"And warn, [O Muḥammad], your closest kindred.","bn":"আর তুমি সতর্ক কর তোমার নিকটাত্মীয় স্বজনদের"},{"ref":"92:14","w":["فَأَنذَرْتُكُمْ","نَارًۭا","تَلَظَّىٰ"],"hi":0,"en":"So I have warned you of a Fire which is blazing.","bn":"কাজেই আমি তোমাদেরকে দাউ দাউ ক’রে জ্বলা আগুন সম্পর্কে সতর্ক করে দিচ্ছি।"},{"ref":"54:36","w":["وَلَقَدْ","أَنذَرَهُم","بَطْشَتَنَا","فَتَمَارَوْا۟","بِٱلنُّذُرِ"],"hi":1,"en":"And he had already warned them of Our assault, but they disputed the warning.","bn":"লূত আমার কঠোর পাকড়াও সম্পর্কে তাদেরকে সতর্ক করে দিয়েছিল, কিন্তু তারা সতর্কবাণীর বিষয়ে বাক বিতন্ডা করেছিল।"}]}